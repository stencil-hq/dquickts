sign of % follows divisor
   -9 % 4 = 3 ; -9 % -4 = -1
   -1 % 4 = 3 ; -1 % -4 = -1
   0 % 4 = 0 ; 0 % -4 = 0
   1 % 4 = 1 ; 1 % -4 = -3
   9 % 4 = 1 ; 9 % -4 = -3
floor vs truncation
   -7 2 floor -4 trunc -3
   7 -2 floor -4 trunc -3
   -1 2 floor -1 trunc 0
divmod type tuple
divmod bool (0, 1) (7, 0)
