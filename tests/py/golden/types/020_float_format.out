format(1e-4, 'g') '0.0001'
format(123456789.0, 'g') '1.23457e+08'
format(0.1, '.17f') '0.10000000000000001'
format(0.1, '.55f') '0.1000000000000000055511151231257827021181583404541015625'
format(1e300, 'f') len 308
format(5e-324, '.3e') '4.941e-324'
format(inf, 'f') 'inf'
format(-inf, 'E') '-INF'
format(nan, '10.2f') '       nan'
format(nan, 'F') 'NAN'
format(inf, '%') 'inf%'
format(1.5, 'd') ValueError Unknown format code 'd' for object of type 'float'
format(1.5, 'x') ValueError Unknown format code 'x' for object of type 'float'
format(1.5, 's') ValueError Unknown format code 's' for object of type 'float'
format(1.5, 'c') ValueError Unknown format code 'c' for object of type 'float'
format(1.5, '.f2') ValueError Format specifier missing precision
format(1.5, ',_') ValueError Cannot specify both ',' and '_'.
format(1234.5, '.2f,') ValueError Invalid format specifier '.2f,' for object of type 'float'
f'{1234.5678:.2f}' '1234.57'
f'{1234.5678:,.1f}' '1,234.6'
f'{0.5:.0%}' '50%'
f'{-1.0:+}' '-1.0'
f'{1.0:+}' '+1.0'
f'{1.0: }' ' 1.0'
f'{1.0:5}' '  1.0'
f'{12.0:.3}' '12.0'
f'{1e20:.3}' '1e+20'
'%f' % 1.5 '1.500000'
'%.2f' % 2.675 '2.67'
'%e' % 12345.678 '1.234568e+04'
'%g' % 0.00001 '1e-05'
'%10.3f|%-10.3f|' % (...) '     3.142|3.142     |'
'%+.1f %+.1f' % (...) '+1.2 -1.2'
'%s %r' % (0.1, 1e16) '0.1 1e+16'
'%d' % 3.99 '3'
'%i' % -3.99 '-3'
'%f' % 'x' TypeError format argument: %f requires a real number, not str
'%.3g' % 1234567 '1.23e+06'
'%#.3g' % 1.0 '1.00'
'%f' % float('inf') 'inf'
'{:.2f}'.format(1/3) '0.33'
'{0:>8.3f}'.format(-1.0) '  -1.000'
