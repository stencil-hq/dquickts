
/* ========================================================================= */
/* Runtime (python/gen_ast_module_runtime.c.in, emitted verbatim)            */
/* ========================================================================= */

#include "modstate.h"

/* typeobject.c (python/typeobject_attr.h): the __dict__ getset of classes
   whose instances have a dict (PyObject_GenericGetDict/SetDict). */
static JSValue qp_subtype_dict_get(JSContext *ctx, JSValueConst self, int magic);
static int qp_subtype_dict_set(JSContext *ctx, JSValueConst self, JSValueConst value, int magic);

/* PyCF_* (Include/cpython/compile.h) */
#define QPAST_PyCF_ONLY_AST              0x0400
#define QPAST_PyCF_TYPE_COMMENTS         0x1000
#define QPAST_PyCF_ALLOW_TOP_LEVEL_AWAIT 0x2000
#define QPAST_PyCF_OPTIMIZED_AST         (0x8000 | QPAST_PyCF_ONLY_AST)

/* State tuple layout (QPModState.ast_state) */
#define QPAST_NSTATE (2 * QPAST_T__COUNT + 1)
#define QPAST_ST_SINGLETON(st, t) ((st)[QPAST_T__COUNT + (t)])
#define QPAST_ST_ABSTRACT(st) ((st)[2 * QPAST_T__COUNT])

static const QPTypeSpec qpast_ast_spec;

/* ---- small helpers ------------------------------------------------------- */

static inline BOOL qpast_is_none(JSValueConst v)
{
    return JS_IsUndefined(v) || JS_IsNull(v);
}

static inline QPType *qpast_type(const JSValue *st, int t)
{
    return qp_type_from_value(st[t]);
}

/* Py_TYPE(x)->tp_name: "ast.AST" for the builtin base, __name__ for the
   classes made by type(). */
static const char *qpast_tp_name(JSContext *ctx, QPType *t, char *buf, int size)
{
    if (t->tp_name)
        return t->tp_name;
    return JS_AtomGetStr(ctx, buf, size, t->name);
}

/* _PyType_Name */
static const char *qpast_short_name(JSContext *ctx, QPType *t, char *buf, int size)
{
    const char *s = qpast_tp_name(ctx, t, buf, size);
    const char *dot = strrchr(s, '.');
    return dot ? dot + 1 : s;
}

static int qpast_check_stack(JSContext *ctx, const char *where, const char *name)
{
    if (js_check_stack_overflow(ctx->rt, 0)) {
        if (name)
            qp_raise(ctx, QP_EXC(ctx, RecursionError),
                     "maximum recursion depth exceeded while traversing '%s' node", name);
        else
            qp_raise(ctx, QP_EXC(ctx, RecursionError), "maximum recursion depth exceeded%s", where);
        return -1;
    }
    return 0;
}

static int qpast_setattr_str(JSContext *ctx, JSValueConst obj, const char *name, JSValueConst v)
{
    JSAtom a = JS_NewAtom(ctx, name);
    int r;
    if (a == JS_ATOM_NULL)
        return -1;
    r = qp_setattr(ctx, obj, a, v);
    JS_FreeAtom(ctx, a);
    return r;
}

static int qpast_getattr_opt_str(JSContext *ctx, JSValueConst obj, const char *name, JSValue *pres)
{
    JSAtom a = JS_NewAtom(ctx, name);
    int r;
    *pres = QP_NULL;
    if (a == JS_ATOM_NULL)
        return -1;
    r = qp_getattr_opt(ctx, obj, a, pres);
    JS_FreeAtom(ctx, a);
    return r;
}

static JSValue qpast_getattr_str(JSContext *ctx, JSValueConst obj, const char *name)
{
    JSAtom a = JS_NewAtom(ctx, name);
    JSValue r;
    if (a == JS_ATOM_NULL)
        return JS_EXCEPTION;
    r = qp_getattr(ctx, obj, a);
    JS_FreeAtom(ctx, a);
    return r;
}

/* Atom of an attribute name object (PyObject_GetAttr/SetAttr checks). */
static JSAtom qpast_name_atom(JSContext *ctx, JSValueConst name)
{
    JSValue s;
    JSAtom a;
    if (!qp_str_check(ctx, name)) {
        char buf[64];
        qp_raise_type_error(ctx, "attribute name must be string, not '%.200s'",
                            qpast_tp_name(ctx, qp_type_of(ctx, name), buf, sizeof(buf)));
        return JS_ATOM_NULL;
    }
    s = qp_str_value(ctx, name);
    if (JS_IsException(s))
        return JS_ATOM_NULL;
    a = qp_str_to_atom(ctx, s);
    JS_FreeValue(ctx, s);
    return a;
}

static int qpast_setattr_obj(JSContext *ctx, JSValueConst obj, JSValueConst name, JSValueConst v)
{
    JSAtom a = qpast_name_atom(ctx, name);
    int r;
    if (a == JS_ATOM_NULL)
        return -1;
    r = qp_setattr(ctx, obj, a, v);
    JS_FreeAtom(ctx, a);
    return r;
}

static JSValue qpast_getattr_obj(JSContext *ctx, JSValueConst obj, JSValueConst name)
{
    JSAtom a = qpast_name_atom(ctx, name);
    JSValue r;
    if (a == JS_ATOM_NULL)
        return JS_EXCEPTION;
    r = qp_getattr(ctx, obj, a);
    JS_FreeAtom(ctx, a);
    return r;
}

/* PySequence_GetItem(seq, i) for 0 <= i */
static JSValue qpast_seq_item(JSContext *ctx, JSValueConst seq, Py_ssize_t i)
{
    JSValue k, r;
    if (qp_tuple_check_exact(ctx, seq) && i < QP_TUPLE_SIZE(seq))
        return JS_DupValue(ctx, QP_TUPLE_ITEMS(seq)[i]);
    k = qp_long_from_int64(ctx, i);
    if (JS_IsException(k))
        return k;
    r = qp_getitem(ctx, seq, k);
    JS_FreeValue(ctx, k);
    return r;
}

/* PyList_GET_ITEM (new reference) */
static JSValue qpast_list_item(JSContext *ctx, JSValueConst list, Py_ssize_t i)
{
    Py_ssize_t n;
    JSValue *items = qp_list_items(list, &n);
    if (items && i < n)
        return JS_DupValue(ctx, items[i]);
    return JS_GetPropertyInt64(ctx, list, i);
}

/* *acc += piece (piece consumed); -1 on error (acc freed). */
static int qpast_cat(JSContext *ctx, JSValue *acc, JSValue piece)
{
    JSValue r;
    if (JS_IsException(piece)) {
        JS_FreeValue(ctx, *acc);
        *acc = JS_UNDEFINED;
        return -1;
    }
    r = qp_str_concat(ctx, *acc, piece);
    JS_FreeValue(ctx, piece);
    JS_FreeValue(ctx, *acc);
    *acc = JS_IsException(r) ? JS_UNDEFINED : r;
    return JS_IsException(r) ? -1 : 0;
}

static int qpast_dict_set_str(JSContext *ctx, JSValueConst d, const char *key, JSValue v)
{
    JSAtom a;
    int r;
    if (JS_IsException(v))
        return -1;
    a = JS_NewAtom(ctx, key);
    if (a == JS_ATOM_NULL) {
        JS_FreeValue(ctx, v);
        return -1;
    }
    r = qp_dict_set_item_atom(ctx, d, a, v);
    JS_FreeAtom(ctx, a);
    JS_FreeValue(ctx, v);
    return r;
}

/* ---- node classes (init_types) ------------------------------------------- */

static JSValue qpast_names_tuple(JSContext *ctx, const QPAstField *f, int n)
{
    JSValue t = qp_tuple_new(ctx, n);
    int i;
    if (JS_IsException(t))
        return t;
    for (i = 0; i < n; i++) {
        JSValue s = qp_str_from_cstr(ctx, qpast_names[f[i].name]);
        if (JS_IsException(s)) {
            JS_FreeValue(ctx, t);
            return JS_EXCEPTION;
        }
        QP_TUPLE_ITEMS(t)[i] = s;
    }
    return t;
}

/* make_type: type(name, (base,), {'_fields': f, '__match_args__': f,
   '__module__': 'ast', '__doc__': doc}) */
static JSValue qpast_make_type(JSContext *ctx, JSValueConst base, int t)
{
    const QPAstTypeDesc *d = &qpast_types[t];
    JSValue fnames, ns, name, bases, res = JS_EXCEPTION;

    fnames = qpast_names_tuple(ctx, &qpast_fields[d->fields], d->nfields);
    if (JS_IsException(fnames))
        return JS_EXCEPTION;
    ns = qp_dict_new(ctx);
    if (JS_IsException(ns)) {
        JS_FreeValue(ctx, fnames);
        return JS_EXCEPTION;
    }
    if (qpast_dict_set_str(ctx, ns, "_fields", JS_DupValue(ctx, fnames)) < 0 ||
        qpast_dict_set_str(ctx, ns, "__match_args__", JS_DupValue(ctx, fnames)) < 0 ||
        qpast_dict_set_str(ctx, ns, "__module__", qp_str_from_cstr(ctx, "ast")) < 0 ||
        qpast_dict_set_str(ctx, ns, "__doc__", qp_str_from_cstr(ctx, d->doc)) < 0) {
        JS_FreeValue(ctx, fnames);
        JS_FreeValue(ctx, ns);
        return JS_EXCEPTION;
    }
    JS_FreeValue(ctx, fnames);
    name = qp_str_from_cstr(ctx, d->name);
    bases = qp_tuple_pack(ctx, 1, &base);
    if (!JS_IsException(name) && !JS_IsException(bases))
        res = qp_type_new(ctx, QP_TYPE(ctx, type), name, bases, ns, QP_NULL);
    JS_FreeValue(ctx, name);
    JS_FreeValue(ctx, bases);
    JS_FreeValue(ctx, ns);
    return res;
}

/* add_attributes */
static int qpast_add_attributes(JSContext *ctx, JSValueConst type, int t)
{
    const QPAstTypeDesc *d = &qpast_types[t];
    JSValue l = qpast_names_tuple(ctx, &qpast_fields[d->attrs], d->nattrs);
    int r;
    if (JS_IsException(l))
        return -1;
    r = qpast_setattr_str(ctx, type, "_attributes", l);
    JS_FreeValue(ctx, l);
    return r;
}

/* emit_defaults: optional fields default to None on the class */
static int qpast_set_defaults(JSContext *ctx, JSValueConst type, int first, int n)
{
    int i;
    for (i = 0; i < n; i++) {
        const QPAstField *f = &qpast_fields[first + i];
        if ((f->flags & QPAST_F_OPT) &&
            qpast_setattr_str(ctx, type, qpast_names[f->name], JS_UNDEFINED) < 0)
            return -1;
    }
    return 0;
}

static JSValue qpast_field_annotation(JSContext *ctx, const JSValue *items, const QPAstField *f)
{
    JSValueConst type;
    JSValue r;
    switch (f->type) {
    case QPAST_B_IDENTIFIER:
    case QPAST_B_STRING:
        type = QP_TYPE_VALUE(QP_TYPE(ctx, str));
        break;
    case QPAST_B_INT:
        type = QP_TYPE_VALUE(QP_TYPE(ctx, int));
        break;
    case QPAST_B_CONSTANT:
        type = QP_TYPE_VALUE(QP_TYPE(ctx, object));
        break;
    default:
        type = items[f->type];
        break;
    }
    if (f->flags & QPAST_F_OPT) {
        r = qp_union_new(ctx, type, JS_UNDEFINED);
        if (!JS_IsException(r) && qp_is_notimpl(ctx, r)) {
            JS_FreeValue(ctx, r);
            return qp_raise_system_error(ctx, "cannot build the annotation of %s",
                                         qpast_names[f->name]);
        }
        return r;
    }
    if (f->flags & QPAST_F_SEQ)
        return qp_generic_alias_new(ctx, QP_TYPE_VALUE(QP_TYPE(ctx, list)), type);
    return JS_DupValue(ctx, type);
}

/* add_ast_annotations for one class: _field_types and __annotations__ */
static int qpast_add_annotations(JSContext *ctx, const JSValue *items, int t)
{
    const QPAstTypeDesc *d = &qpast_types[t];
    JSValue ann = qp_dict_new(ctx);
    int i, r;
    if (JS_IsException(ann))
        return -1;
    for (i = 0; i < d->nfields; i++) {
        const QPAstField *f = &qpast_fields[d->fields + i];
        if (qpast_dict_set_str(ctx, ann, qpast_names[f->name],
                               qpast_field_annotation(ctx, items, f)) < 0) {
            JS_FreeValue(ctx, ann);
            return -1;
        }
    }
    r = qpast_setattr_str(ctx, items[t], "_field_types", ann);
    if (r == 0)
        r = qpast_setattr_str(ctx, items[t], "__annotations__", ann);
    JS_FreeValue(ctx, ann);
    return r;
}

/* init_types: fills items[] (all JS_UNDEFINED on entry); on failure the
   caller releases what was stored. */
static int qpast_init_types(JSContext *ctx, JSValue *items)
{
    JSValue empty, abstract, type;
    int t, r;

    type = qp_type_from_spec(ctx, &qpast_ast_spec);
    if (JS_IsException(type))
        return -1;
    items[QPAST_T_AST] = type;
    abstract = qp_set_new(ctx, QP_NULL);
    if (JS_IsException(abstract))
        return -1;
    QPAST_ST_ABSTRACT(items) = abstract;
    if (qp_set_add(ctx, abstract, type) < 0)
        return -1;
    /* add_ast_fields */
    empty = qp_tuple_new(ctx, 0);
    if (JS_IsException(empty))
        return -1;
    r = qpast_setattr_str(ctx, type, "_fields", empty);
    if (r == 0)
        r = qpast_setattr_str(ctx, type, "__match_args__", empty);
    if (r == 0)
        r = qpast_setattr_str(ctx, type, "_attributes", empty);
    JS_FreeValue(ctx, empty);
    if (r < 0)
        return -1;

    for (t = 1; t < QPAST_T__COUNT; t++) {
        const QPAstTypeDesc *d = &qpast_types[t];
        type = qpast_make_type(ctx, items[d->base], t);
        if (JS_IsException(type))
            return -1;
        items[t] = type;
        switch (d->kind) {
        case QPAST_K_SUM:
        case QPAST_K_SIMPLE_SUM:
            if (qpast_add_attributes(ctx, type, t) < 0 ||
                qp_set_add(ctx, abstract, type) < 0 ||
                qpast_set_defaults(ctx, type, d->attrs, d->nattrs) < 0)
                return -1;
            break;
        case QPAST_K_CONS:
            if (qpast_set_defaults(ctx, type, d->fields, d->nfields) < 0)
                return -1;
            break;
        case QPAST_K_SIMPLE_CONS: {
            JSValue s;
            if (qpast_set_defaults(ctx, type, d->fields, d->nfields) < 0)
                return -1;
            s = qp_object_new_instance(ctx, qp_type_from_value(type), JS_CLASS_PY_OBJECT);
            if (JS_IsException(s))
                return -1;
            QPAST_ST_SINGLETON(items, t) = s;
            break;
        }
        case QPAST_K_PRODUCT:
            if (qpast_add_attributes(ctx, type, t) < 0 ||
                qpast_set_defaults(ctx, type, d->fields, d->nfields) < 0 ||
                qpast_set_defaults(ctx, type, d->attrs, d->nattrs) < 0)
                return -1;
            break;
        }
    }
    for (t = 1; t < QPAST_T__COUNT; t++) {
        int k = qpast_types[t].kind;
        if ((k == QPAST_K_CONS || k == QPAST_K_SIMPLE_CONS || k == QPAST_K_PRODUCT) &&
            qpast_add_annotations(ctx, items, t) < 0)
            return -1;
    }
    return 0;
}

/* get_ast_state: borrowed state items, NULL with an exception pending. */
static const JSValue *qpast_state(JSContext *ctx)
{
    QPModState *ms = qp_modstate(ctx);
    JSValue *items, tup;
    int i;

    if (!ms)
        return NULL;
    if (!QP_IS_NULL(ms->ast_state))
        return QP_TUPLE_ITEMS(ms->ast_state);
    items = js_malloc(ctx, sizeof(items[0]) * QPAST_NSTATE);
    if (!items)
        return NULL;
    for (i = 0; i < QPAST_NSTATE; i++)
        items[i] = JS_UNDEFINED;
    if (qpast_init_types(ctx, items) < 0) {
        for (i = 0; i < QPAST_NSTATE; i++)
            JS_FreeValue(ctx, items[i]);
        js_free(ctx, items);
        return NULL;
    }
    tup = qp_tuple_new_steal(ctx, QPAST_NSTATE, items);
    js_free(ctx, items);
    if (JS_IsException(tup))
        return NULL;
    if (!QP_IS_NULL(ms->ast_state)) {
        /* created meanwhile by code run during the initialisation */
        JS_FreeValue(ctx, tup);
        return QP_TUPLE_ITEMS(ms->ast_state);
    }
    ms->ast_state = tup;
    return QP_TUPLE_ITEMS(tup);
}

/* ---- ast.AST ------------------------------------------------------------- */

static JSValue qpast_new(JSContext *ctx, QPType *subtype, JSValueConst *args, size_t nargsf,
                         JSValueConst kwnames)
{
    /* PyType_GenericNew */
    return qp_object_new_instance(ctx, subtype, JS_CLASS_PY_OBJECT);
}

/* format_missing: the names of the set `missing` in the order of `fields`,
   as a natural language list. */
static JSValue qpast_format_missing(JSContext *ctx, JSValueConst missing, JSValueConst fields)
{
    Py_ssize_t num_fields, num_total, num_left, i;
    JSValue acc;

    num_fields = qp_len(ctx, fields);
    if (num_fields < 0)
        return JS_EXCEPTION;
    num_total = num_left = qp_set_size(missing);
    acc = qp_str_from_cstr(ctx, "");
    if (JS_IsException(acc))
        return acc;
    for (i = 0; i < num_fields; i++) {
        JSValue name = qpast_seq_item(ctx, fields, i);
        int contains;
        if (JS_IsException(name))
            goto error;
        contains = qp_set_contains(ctx, missing, name);
        if (contains < 0) {
            JS_FreeValue(ctx, name);
            goto error;
        }
        if (contains == 1) {
            const char *fmt;
            if (num_left == 1)
                fmt = "'%U'";
            else if (num_total == 2)
                fmt = "'%U' and ";
            else if (num_left == 2)
                fmt = "'%U', and ";
            else
                fmt = "'%U', ";
            num_left--;
            if (qpast_cat(ctx, &acc, qp_str_from_format(ctx, fmt, name)) < 0) {
                JS_FreeValue(ctx, name);
                return JS_EXCEPTION;
            }
        }
        JS_FreeValue(ctx, name);
    }
    return acc;
error:
    JS_FreeValue(ctx, acc);
    return JS_EXCEPTION;
}

/* ast_type_init */
static int qpast_init(JSContext *ctx, JSValueConst self, JSValueConst *args, size_t nargsf,
                      JSValueConst kwnames)
{
    const JSValue *st = qpast_state(ctx);
    QPType *tp = qp_type_of(ctx, self);
    JSValueConst type = QP_TYPE_VALUE(tp);
    Py_ssize_t nargs = qp_nargs(nargsf), nkw, numfields, i, size;
    JSValue fields = JS_UNDEFINED, attributes = QP_NULL, remaining = JS_UNDEFINED;
    JSValue field_types = QP_NULL, remaining_list = JS_UNDEFINED, missing = JS_UNDEFINED;
    int res = -1, contains;
    char buf[64];

    if (!st)
        return -1;
    contains = qp_set_contains(ctx, QPAST_ST_ABSTRACT(st), type);
    if (contains < 0)
        return -1;
    if (contains == 1 &&
        qp_warn(ctx, QP_EXC(ctx, DeprecationWarning), 1,
                "Instantiating abstract AST node class %T is deprecated. "
                "This will become an error in Python 3.20", self) < 0)
        return -1;

    fields = qpast_getattr_str(ctx, type, "_fields");
    if (JS_IsException(fields))
        return -1;
    numfields = qp_len(ctx, fields);
    if (numfields < 0)
        goto cleanup;
    remaining = qp_set_new(ctx, fields);
    if (JS_IsException(remaining)) {
        remaining = JS_UNDEFINED;
        goto cleanup;
    }
    if (numfields < nargs) {
        qp_raise_type_error(ctx, "%.400s constructor takes at most %zd positional argument%s",
                            qpast_short_name(ctx, tp, buf, sizeof(buf)), numfields,
                            numfields == 1 ? "" : "s");
        goto cleanup;
    }
    for (i = 0; i < nargs; i++) {
        JSValue name = qpast_seq_item(ctx, fields, i);
        int r;
        if (JS_IsException(name))
            goto cleanup;
        r = qpast_setattr_obj(ctx, self, name, args[i]);
        if (qp_set_discard(ctx, remaining, name) < 0) {
            JS_FreeValue(ctx, name);
            goto cleanup;
        }
        JS_FreeValue(ctx, name);
        if (r < 0)
            goto cleanup;
    }
    nkw = QP_IS_NULL(kwnames) ? 0 : QP_TUPLE_SIZE(kwnames);
    for (i = 0; i < nkw; i++) {
        JSValueConst key = QP_TUPLE_ITEMS(kwnames)[i];
        JSValueConst value = args[nargs + i];
        contains = qp_contains(ctx, fields, key);
        if (contains < 0)
            goto cleanup;
        if (contains == 1) {
            int p = qp_set_discard(ctx, remaining, key);
            if (p < 0)
                goto cleanup;
            if (p == 0) {
                qp_raise_type_error(ctx, "%T got multiple values for argument %R", self, key);
                goto cleanup;
            }
        } else {
            if (QP_IS_NULL(attributes)) {
                attributes = qpast_getattr_str(ctx, type, "_attributes");
                if (JS_IsException(attributes)) {
                    attributes = QP_NULL;
                    goto cleanup;
                }
            }
            contains = qp_contains(ctx, attributes, key);
            if (contains < 0)
                goto cleanup;
            if (contains == 0) {
                qp_raise_type_error(ctx, "%T.__init__ got an unexpected keyword argument %R",
                                    self, key);
                goto cleanup;
            }
        }
        if (qpast_setattr_obj(ctx, self, key, value) < 0)
            goto cleanup;
    }
    size = qp_set_size(remaining);
    if (size > 0) {
        Py_ssize_t num_missing;
        int r = qpast_getattr_opt_str(ctx, type, "_field_types", &field_types);
        if (r < 0)
            goto cleanup;
        if (r == 0) {
            /* Probably a user-defined subclass of AST that lacks
               _field_types: attributes that are not passed in simply do not
               exist on the instance (as before 3.13). */
            res = 0;
            goto cleanup;
        }
        remaining_list = qp_list_from_iterable(ctx, remaining);
        if (JS_IsException(remaining_list)) {
            remaining_list = JS_UNDEFINED;
            goto cleanup;
        }
        missing = qp_set_new(ctx, QP_NULL);
        if (JS_IsException(missing)) {
            missing = JS_UNDEFINED;
            goto cleanup;
        }
        for (i = 0; i < size; i++) {
            JSValue name = qpast_list_item(ctx, remaining_list, i), ftype;
            int found;
            QPType *ft;
            if (JS_IsException(name))
                goto cleanup;
            if (!qp_anydict_check(ctx, field_types)) {
                JS_FreeValue(ctx, name);
                qp_raise_system_error(ctx, "bad argument to internal function");
                goto cleanup;
            }
            found = qp_dict_get_item(ctx, field_types, name, &ftype);
            if (found < 0) {
                JS_FreeValue(ctx, name);
                goto cleanup;
            }
            if (found == 0) {
                qp_raise_type_error(ctx, "Field %R is missing from %T._field_types", name, self);
                JS_FreeValue(ctx, name);
                goto cleanup;
            }
            ft = qp_type_of(ctx, ftype);
            if (ft == QP_TYPE(ctx, Union)) {
                /* optional field: the class has a None default */
                r = 0;
            } else if (ft == QP_TYPE(ctx, GenericAlias)) {
                /* list field */
                JSValue empty = qp_list_new(ctx, 0);
                r = JS_IsException(empty) ? -1 : qpast_setattr_obj(ctx, self, name, empty);
                JS_FreeValue(ctx, empty);
            } else if (qp_is(ftype, st[QPAST_T_expr_context])) {
                /* expr_context defaults to Load() */
                r = qpast_setattr_obj(ctx, self, name, QPAST_ST_SINGLETON(st, QPAST_T_Load));
            } else {
                /* simple field (e.g. identifier) */
                r = qp_set_add(ctx, missing, name);
            }
            JS_FreeValue(ctx, ftype);
            JS_FreeValue(ctx, name);
            if (r < 0)
                goto cleanup;
        }
        num_missing = qp_set_size(missing);
        if (num_missing > 0) {
            JSValue name_str = qpast_format_missing(ctx, missing, fields);
            if (JS_IsException(name_str))
                goto cleanup;
            qp_raise_type_error(ctx, "%T.__init__ missing %d required positional argument%s: %U",
                                self, (int)num_missing, num_missing == 1 ? "" : "s", name_str);
            JS_FreeValue(ctx, name_str);
            goto cleanup;
        }
    }
    res = 0;
cleanup:
    JS_FreeValue(ctx, missing);
    JS_FreeValue(ctx, remaining_list);
    if (!QP_IS_NULL(field_types))
        JS_FreeValue(ctx, field_types);
    if (!QP_IS_NULL(attributes))
        JS_FreeValue(ctx, attributes);
    JS_FreeValue(ctx, fields);
    JS_FreeValue(ctx, remaining);
    return res;
}

/* __reduce__ (pickling and copying) */
static JSValue qpast_reduce(JSContext *ctx, JSValueConst self, JSValueConst *args,
                            int nargs, JSValueConst kwnames, int magic)
{
    JSValueConst type = QP_TYPE_VALUE(qp_type_of(ctx, self));
    JSValue dict, fields = QP_NULL, positional = JS_UNDEFINED, result = JS_EXCEPTION, items[3];
    Py_ssize_t numfields, i;
    int r;

    r = qpast_getattr_opt_str(ctx, self, "__dict__", &dict);
    if (r < 0)
        return JS_EXCEPTION;
    if (r == 0) {
        /* (type, ()) */
        items[0] = JS_DupValue(ctx, type);
        items[1] = qp_tuple_new(ctx, 0);
        if (JS_IsException(items[1])) {
            JS_FreeValue(ctx, items[0]);
            return JS_EXCEPTION;
        }
        return qp_tuple_new_steal(ctx, 2, items);
    }
    /* Construct with only positional arguments, all None (every required
       field is given, and no child node is copied through them, gh-120108),
       then set the fields from the dict. */
    r = qpast_getattr_opt_str(ctx, type, "_fields", &fields);
    if (r < 0)
        goto cleanup;
    if (r == 0) {
        items[0] = JS_DupValue(ctx, type);
        items[1] = qp_tuple_new(ctx, 0);
        items[2] = JS_DupValue(ctx, dict);
        if (JS_IsException(items[1])) {
            JS_FreeValue(ctx, items[0]);
            JS_FreeValue(ctx, items[2]);
            goto cleanup;
        }
        result = qp_tuple_new_steal(ctx, 3, items);
        goto cleanup;
    }
    numfields = qp_len(ctx, fields);
    if (numfields < 0)
        goto cleanup;
    positional = qp_list_new(ctx, 0);
    if (JS_IsException(positional)) {
        positional = JS_UNDEFINED;
        goto cleanup;
    }
    for (i = 0; i < numfields; i++) {
        JSValue name = qpast_seq_item(ctx, fields, i), value;
        int rc;
        if (JS_IsException(name))
            goto cleanup;
        rc = qp_dict_get_item(ctx, dict, name, &value);
        JS_FreeValue(ctx, name);
        if (rc < 0)
            goto cleanup;
        if (rc == 0)
            break;
        JS_FreeValue(ctx, value);
        if (qp_list_append(ctx, positional, JS_UNDEFINED) < 0)
            goto cleanup;
    }
    items[1] = qp_list_as_tuple(ctx, positional);
    if (JS_IsException(items[1]))
        goto cleanup;
    items[0] = JS_DupValue(ctx, type);
    items[2] = JS_DupValue(ctx, dict);
    result = qp_tuple_new_steal(ctx, 3, items);
cleanup:
    JS_FreeValue(ctx, dict);
    if (!QP_IS_NULL(fields))
        JS_FreeValue(ctx, fields);
    JS_FreeValue(ctx, positional);
    return result;
}

/* ast_type_replace_update_payload: payload[key] = dict[key] for the keys
   present in the instance dict. */
static int qpast_replace_update_payload(JSContext *ctx, JSValueConst payload, JSValueConst keys,
                                        JSValueConst dict)
{
    Py_ssize_t n, i;
    if (QP_IS_NULL(keys))
        return 0;
    n = qp_len(ctx, keys);
    if (n < 0)
        return -1;
    for (i = 0; i < n; i++) {
        JSValue key = qpast_seq_item(ctx, keys, i), value;
        int rc;
        if (JS_IsException(key))
            return -1;
        rc = qp_dict_get_item(ctx, dict, key, &value);
        if (rc < 0) {
            JS_FreeValue(ctx, key);
            return -1;
        }
        if (rc == 0) {
            /* absent: must be given in kwargs, else the constructor complains */
            JS_FreeValue(ctx, key);
            continue;
        }
        rc = qp_dict_set_item(ctx, payload, key, value);
        JS_FreeValue(ctx, key);
        JS_FreeValue(ctx, value);
        if (rc < 0)
            return -1;
    }
    return 0;
}

/* __replace__(**fields): copy.replace() support (shallow copy) */
static JSValue qpast_replace(JSContext *ctx, JSValueConst self, JSValueConst *args,
                             int nargs, JSValueConst kwnames, int magic)
{
    JSValueConst type = QP_TYPE_VALUE(qp_type_of(ctx, self));
    JSValue fields = QP_NULL, attributes = QP_NULL, dict = QP_NULL;
    JSValue empty_tuple = JS_UNDEFINED, payload = JS_UNDEFINED, result = JS_EXCEPTION;
    Py_ssize_t nkw = QP_IS_NULL(kwnames) ? 0 : QP_TUPLE_SIZE(kwnames), i;

    if (nargs > 0)
        return qp_raise_type_error(ctx, "__replace__() takes no positional arguments");
    if (qpast_getattr_opt_str(ctx, type, "_fields", &fields) < 0 ||
        qpast_getattr_opt_str(ctx, type, "_attributes", &attributes) < 0 ||
        qpast_getattr_opt_str(ctx, self, "__dict__", &dict) < 0)
        goto cleanup;
    empty_tuple = qp_tuple_new(ctx, 0);
    if (JS_IsException(empty_tuple)) {
        empty_tuple = JS_UNDEFINED;
        goto cleanup;
    }
    payload = qp_dict_new(ctx);
    if (JS_IsException(payload)) {
        payload = JS_UNDEFINED;
        goto cleanup;
    }
    if (!QP_IS_NULL(dict)) {
        if (qpast_replace_update_payload(ctx, payload, fields, dict) < 0 ||
            qpast_replace_update_payload(ctx, payload, attributes, dict) < 0)
            goto cleanup;
    }
    for (i = 0; i < nkw; i++) {
        if (qp_dict_set_item(ctx, payload, QP_TUPLE_ITEMS(kwnames)[i], args[nargs + i]) < 0)
            goto cleanup;
    }
    result = qp_call_tuple(ctx, type, empty_tuple, payload);
cleanup:
    JS_FreeValue(ctx, payload);
    JS_FreeValue(ctx, empty_tuple);
    if (!QP_IS_NULL(dict))
        JS_FreeValue(ctx, dict);
    if (!QP_IS_NULL(attributes))
        JS_FreeValue(ctx, attributes);
    if (!QP_IS_NULL(fields))
        JS_FreeValue(ctx, fields);
    return result;
}

static JSValue qpast_repr_max_depth(JSContext *ctx, const JSValue *st, JSValueConst self,
                                    int depth);

static BOOL qpast_is_ast(JSContext *ctx, const JSValue *st, JSValueConst v)
{
    return qp_type_is_subtype(qp_type_of(ctx, v), qpast_type(st, QPAST_T_AST));
}

/* ast_repr_list: only the first and last elements are shown. */
static JSValue qpast_repr_list(JSContext *ctx, const JSValue *st, JSValueConst list, int depth)
{
    Py_ssize_t length, i;
    JSValue items[2] = { JS_UNDEFINED, JS_UNDEFINED }, acc = JS_UNDEFINED;
    BOOL is_list;

    length = qp_len(ctx, list);
    if (length < 0)
        return JS_EXCEPTION;
    if (length == 0)
        return qp_repr(ctx, list);
    items[0] = qpast_seq_item(ctx, list, 0);
    if (JS_IsException(items[0]))
        return JS_EXCEPTION;
    if (length > 1) {
        items[1] = qpast_seq_item(ctx, list, length - 1);
        if (JS_IsException(items[1])) {
            JS_FreeValue(ctx, items[0]);
            return JS_EXCEPTION;
        }
    }
    is_list = qp_list_check(ctx, list);
    acc = qp_str_from_cstr(ctx, is_list ? "[" : "(");
    if (JS_IsException(acc))
        goto error;
    for (i = 0; i < (length < 2 ? length : 2); i++) {
        JSValue item_repr;
        if (i > 0 && qpast_cat(ctx, &acc, qp_str_from_cstr(ctx, ", ")) < 0)
            goto error;
        if (qpast_is_ast(ctx, st, items[i]))
            item_repr = qpast_repr_max_depth(ctx, st, items[i], depth - 1);
        else
            item_repr = qp_repr(ctx, items[i]);
        if (qpast_cat(ctx, &acc, item_repr) < 0)
            goto error;
        if (i == 0 && length > 2 && qpast_cat(ctx, &acc, qp_str_from_cstr(ctx, ", ...")) < 0)
            goto error;
    }
    if (qpast_cat(ctx, &acc, qp_str_from_cstr(ctx, is_list ? "]" : ")")) < 0)
        goto error;
    JS_FreeValue(ctx, items[0]);
    JS_FreeValue(ctx, items[1]);
    return acc;
error:
    JS_FreeValue(ctx, items[0]);
    JS_FreeValue(ctx, items[1]);
    JS_FreeValue(ctx, acc);
    return JS_EXCEPTION;
}

static JSValue qpast_repr_max_depth(JSContext *ctx, const JSValue *st, JSValueConst self,
                                    int depth)
{
    QPType *tp = qp_type_of(ctx, self);
    char buf[128];
    const char *tp_name = qpast_tp_name(ctx, tp, buf, sizeof(buf));
    JSValue fields, acc = JS_UNDEFINED;
    Py_ssize_t numfields, i;
    int status;

    if (depth <= 0)
        return qp_str_from_format(ctx, "%s(...)", tp_name);
    status = qp_repr_enter(ctx, self);
    if (status != 0) {
        if (status < 0)
            return JS_EXCEPTION;
        return qp_str_from_format(ctx, "%s(...)", tp_name);
    }
    fields = qpast_getattr_str(ctx, QP_TYPE_VALUE(tp), "_fields");
    if (JS_IsException(fields)) {
        qp_repr_leave(ctx, self);
        return JS_EXCEPTION;
    }
    numfields = qp_len(ctx, fields);
    if (numfields < 0) {
        qp_repr_leave(ctx, self);
        JS_FreeValue(ctx, fields);
        return JS_EXCEPTION;
    }
    if (numfields == 0) {
        qp_repr_leave(ctx, self);
        JS_FreeValue(ctx, fields);
        return qp_str_from_format(ctx, "%s()", tp_name);
    }
    acc = qp_str_from_format(ctx, "%s(", tp_name);
    if (JS_IsException(acc)) {
        acc = JS_UNDEFINED;
        goto error;
    }
    for (i = 0; i < numfields; i++) {
        JSValue name = qpast_seq_item(ctx, fields, i), value, value_repr;
        if (JS_IsException(name))
            goto error;
        value = qpast_getattr_obj(ctx, self, name);
        if (JS_IsException(value)) {
            JS_FreeValue(ctx, name);
            goto error;
        }
        if (qp_list_check(ctx, value) || qp_tuple_check(ctx, value))
            value_repr = qpast_repr_list(ctx, st, value, depth);
        else if (qpast_is_ast(ctx, st, value))
            value_repr = qpast_repr_max_depth(ctx, st, value, depth - 1);
        else
            value_repr = qp_repr(ctx, value);
        JS_FreeValue(ctx, value);
        if (JS_IsException(value_repr)) {
            JS_FreeValue(ctx, name);
            goto error;
        }
        if (i > 0 && qpast_cat(ctx, &acc, qp_str_from_cstr(ctx, ", ")) < 0) {
            JS_FreeValue(ctx, name);
            JS_FreeValue(ctx, value_repr);
            goto error;
        }
        if (qpast_cat(ctx, &acc, name) < 0 ||
            qpast_cat(ctx, &acc, qp_str_from_cstr(ctx, "=")) < 0) {
            JS_FreeValue(ctx, value_repr);
            goto error;
        }
        if (qpast_cat(ctx, &acc, value_repr) < 0)
            goto error;
    }
    if (qpast_cat(ctx, &acc, qp_str_from_cstr(ctx, ")")) < 0)
        goto error;
    qp_repr_leave(ctx, self);
    JS_FreeValue(ctx, fields);
    return acc;
error:
    qp_repr_leave(ctx, self);
    JS_FreeValue(ctx, fields);
    JS_FreeValue(ctx, acc);
    return JS_EXCEPTION;
}

static JSValue qpast_repr(JSContext *ctx, JSValueConst self)
{
    const JSValue *st = qpast_state(ctx);
    if (!st)
        return JS_EXCEPTION;
    return qpast_repr_max_depth(ctx, st, self, 3);
}

static const QPMethodDef qpast_ast_methods[] = {
    { "__reduce__", qpast_reduce, QP_METH_NOARGS, 0, NULL },
    { "__replace__", qpast_replace, QP_METH_FASTCALL | QP_METH_KEYWORDS, 0,
      "__replace__($self, /, **fields)\n--\n\n"
      "Return a copy of the AST node with new values for the specified fields." },
    { NULL }
};

static const QPGetSetDef qpast_ast_getsets[] = {
    { "__dict__", qp_subtype_dict_get, qp_subtype_dict_set, 0, NULL },
    { NULL }
};

static const QPTypeSpec qpast_ast_spec = {
    .name = "ast.AST",
    .flags = QP_TPFLAGS_DEFAULT | QP_TPFLAGS_BASETYPE | QP_TPFLAGS_MANAGED_DICT,
    .base = -1,
    .exc_base = -1,
    .instance_class_id = JS_CLASS_PY_OBJECT,
    .nslots = 0,
    .slots = {
        .tp_getattro = qp_generic_getattr,
        .tp_setattro = qp_generic_setattr,
        .tp_repr = qpast_repr,
        .tp_init = qpast_init,
        .tp_new = qpast_new,
    },
    .methods = qpast_ast_methods,
    .getsets = qpast_ast_getsets,
};

/* ---- conversions: shared context ----------------------------------------- */

typedef struct QPAstConv {
    JSContext *ctx;
    const JSValue *st;
    qp_arena *arena;                    /* obj2ast only */
    JSAtom atoms[QPAST_N__COUNT];       /* field and attribute names */
} QPAstConv;

static void qpast_conv_free(QPAstConv *cv)
{
    int i;
    for (i = 0; i < QPAST_N__COUNT; i++)
        JS_FreeAtom(cv->ctx, cv->atoms[i]);
}

static int qpast_conv_init(QPAstConv *cv, JSContext *ctx, qp_arena *arena)
{
    int i;
    cv->ctx = ctx;
    cv->arena = arena;
    for (i = 0; i < QPAST_N__COUNT; i++)
        cv->atoms[i] = JS_ATOM_NULL;
    cv->st = qpast_state(ctx);
    if (!cv->st)
        return -1;
    for (i = 0; i < QPAST_N__COUNT; i++) {
        cv->atoms[i] = JS_NewAtom(ctx, qpast_names[i]);
        if (cv->atoms[i] == JS_ATOM_NULL) {
            qpast_conv_free(cv);
            return -1;
        }
    }
    return 0;
}

/* Storage address of element i of an asdl sequence whose elements have
   the field type `type`. */
static void *qpast_seq_elem(asdl_seq *s, int type, Py_ssize_t i)
{
    if (type == QPAST_B_IDENTIFIER || type == QPAST_B_STRING)
        return &((asdl_identifier_seq *)s)->typed_elements[i];
    if (type == QPAST_B_INT || (type >= 0 && qpast_types[type].kind == QPAST_K_SIMPLE_SUM))
        return &((asdl_int_seq *)s)->typed_elements[i];
    return &s->elements[i];
}

/* Python value of a constant (new reference). */
static JSValue qpast_const2obj(JSContext *ctx, const qp_const *k)
{
    if (!k)
        return JS_UNDEFINED;
    switch (k->kind) {
    case QP_CONST_NONE:
        return JS_UNDEFINED;
    case QP_CONST_TRUE:
        return JS_TRUE;
    case QP_CONST_FALSE:
        return JS_FALSE;
    case QP_CONST_ELLIPSIS:
        return JS_DupValue(ctx, QP_STATE(ctx)->ellipsis);
    case QP_CONST_INT:
        return qp_long_normalize(ctx, JS_DupValue(ctx, k->v));
    case QP_CONST_FLOAT:
    case QP_CONST_STR:
    case QP_CONST_OBJECT:
        return JS_DupValue(ctx, k->v);
    case QP_CONST_COMPLEX:
        return qp_complex_new(ctx, 0.0, JS_VALUE_GET_FLOAT64(k->v));
    case QP_CONST_BYTES: {
        JSString *p = JS_VALUE_GET_STRING(k->v);
        JSValue r;
        uint8_t *tmp;
        uint32_t i;
        if (!p->is_wide_char)
            return qp_bytes_new(ctx, p->u.str8, p->len);
        tmp = js_malloc(ctx, p->len ? p->len : 1);
        if (!tmp)
            return JS_EXCEPTION;
        for (i = 0; i < p->len; i++)
            tmp[i] = (uint8_t)p->u.str16[i];
        r = qp_bytes_new(ctx, tmp, p->len);
        js_free(ctx, tmp);
        return r;
    }
    }
    return qp_raise_system_error(ctx, "unknown constant kind %d", (int)k->kind);
}

/* A Python value as an AST constant owned by `arena` (obj2ast_constant:
   any object is accepted; _PyAST_Validate checks the type). */
static qp_const *qpast_obj2const(JSContext *ctx, qp_arena *arena, JSValueConst v)
{
    QPType *tp;
    qp_const *c;
    qp_const_kind kind;
    JSValue val;

    switch (JS_VALUE_GET_TAG(v)) {
    case JS_TAG_UNDEFINED:
    case JS_TAG_NULL:
        return &qp_const_none;
    case JS_TAG_BOOL:
        return JS_VALUE_GET_BOOL(v) ? &qp_const_true : &qp_const_false;
    case JS_TAG_INT:
    case JS_TAG_SHORT_BIG_INT:
    case JS_TAG_BIG_INT:
        kind = QP_CONST_INT;
        val = JS_DupValue(ctx, v);
        break;
    case JS_TAG_FLOAT64:
        kind = QP_CONST_FLOAT;
        val = JS_DupValue(ctx, v);
        break;
    case JS_TAG_STRING:
        kind = QP_CONST_STR;
        val = JS_DupValue(ctx, v);
        break;
    case JS_TAG_STRING_ROPE:
        kind = QP_CONST_STR;
        val = js_linearize_string_rope(ctx, JS_DupValue(ctx, v));
        if (JS_IsException(val))
            return NULL;
        break;
    default:
        if (JS_VALUE_GET_TAG(v) == JS_TAG_OBJECT &&
            JS_VALUE_GET_PTR(v) == JS_VALUE_GET_PTR(QP_STATE(ctx)->ellipsis))
            return &qp_const_ellipsis;
        tp = qp_type_of(ctx, v);
        if (tp == QP_TYPE(ctx, bytes)) {
            Py_ssize_t n;
            const uint8_t *data = qp_bytes_data(v, &n);
            kind = QP_CONST_BYTES;
            val = js_new_string8_len(ctx, (const char *)data, (int)n);
            if (JS_IsException(val))
                return NULL;
            break;
        }
        if (tp == QP_TYPE(ctx, complex)) {
            QPComplex z;
            if (qp_complex_as_c(ctx, v, &z) < 0)
                return NULL;
            if (z.real == 0.0 && !signbit(z.real)) {
                kind = QP_CONST_COMPLEX;
                val = qp_float_new(ctx, z.imag);
                break;
            }
        }
        kind = QP_CONST_OBJECT;
        val = JS_DupValue(ctx, v);
        break;
    }
    c = qp_const_new(arena, kind, val);
    if (!c)
        qp_raise_memory_error(ctx);
    return c;
}

/* Arena failure (constructor error or out of memory) as a Python exception. */
static void qpast_raise_arena_error(JSContext *ctx, qp_arena *arena)
{
    qp_error *err = qp_arena_error(arena);
    if (err->kind == QP_ERR_VALUE && err->msg)
        qp_raise_value_error(ctx, "%s", err->msg);
    else
        qp_raise_memory_error(ctx);
    qp_error_clear(err);
}

/* ---- ast2obj -------------------------------------------------------------- */

static JSValue qpast_node2obj(QPAstConv *cv, int t, const void *node);

static JSValue qpast_simple2obj(QPAstConv *cv, int t, int value)
{
    const QPAstTypeDesc *d = &qpast_types[t];
    int i;
    for (i = 0; i < d->ncons; i++) {
        if (qpast_types[d->sum + i].value == value)
            return JS_DupValue(cv->ctx, QPAST_ST_SINGLETON(cv->st, d->sum + i));
    }
    return qp_raise_system_error(cv->ctx, "invalid %s value %d", d->name, value);
}

static JSValue qpast_elem2obj(QPAstConv *cv, int type, const void *p)
{
    JSContext *ctx = cv->ctx;
    switch (type) {
    case QPAST_B_IDENTIFIER:
    case QPAST_B_STRING: {
        JSAtom a = *(const JSAtom *)p;
        return a == JS_ATOM_NULL ? JS_UNDEFINED : qp_str_from_atom(ctx, a);
    }
    case QPAST_B_INT:
        return JS_NewInt32(ctx, *(const int *)p);
    case QPAST_B_CONSTANT:
        return qpast_const2obj(ctx, *(qp_const *const *)p);
    default:
        if (qpast_types[type].kind == QPAST_K_SIMPLE_SUM)
            return qpast_simple2obj(cv, type, *(const int *)p);
        return qpast_node2obj(cv, type, *(void *const *)p);
    }
}

static JSValue qpast_field2obj(QPAstConv *cv, const QPAstField *f, const char *base)
{
    JSContext *ctx = cv->ctx;
    const char *p = base + f->offset;
    asdl_seq *s;
    Py_ssize_t i, n;
    JSValue *items;

    if (!(f->flags & QPAST_F_SEQ))
        return qpast_elem2obj(cv, f->type, p);
    s = *(asdl_seq *const *)p;
    n = asdl_seq_LEN(s);
    if (n == 0)
        return qp_list_new(ctx, 0);
    items = js_malloc(ctx, sizeof(items[0]) * n);
    if (!items)
        return JS_EXCEPTION;
    for (i = 0; i < n; i++) {
        items[i] = qpast_elem2obj(cv, f->type, qpast_seq_elem(s, f->type, i));
        if (JS_IsException(items[i])) {
            while (i-- > 0)
                JS_FreeValue(ctx, items[i]);
            js_free(ctx, items);
            return JS_EXCEPTION;
        }
    }
    {
        JSValue list = qp_list_new_steal(ctx, n, items);
        js_free(ctx, items);
        return list;
    }
}

static int qpast_set_fields(QPAstConv *cv, JSValueConst result, int first, int n,
                            const char *base)
{
    int i;
    for (i = 0; i < n; i++) {
        const QPAstField *f = &qpast_fields[first + i];
        JSValue value = qpast_field2obj(cv, f, base);
        int r;
        if (JS_IsException(value))
            return -1;
        r = qp_setattr(cv->ctx, result, cv->atoms[f->name], value);
        JS_FreeValue(cv->ctx, value);
        if (r < 0)
            return -1;
    }
    return 0;
}

static JSValue qpast_node2obj(QPAstConv *cv, int t, const void *node)
{
    JSContext *ctx = cv->ctx;
    const QPAstTypeDesc *d = &qpast_types[t];
    const QPAstTypeDesc *c = d;
    JSValue result;
    int ct = t;

    if (!node)
        return JS_UNDEFINED;
    if (qpast_check_stack(ctx, "during  ast construction", NULL) < 0)
        return JS_EXCEPTION;
    if (d->kind == QPAST_K_SUM) {
        int kind = *(const int *)((const char *)node + d->kind_offset), i;
        for (i = 0; i < d->ncons; i++) {
            if (qpast_types[d->sum + i].value == kind)
                break;
        }
        if (i == d->ncons)
            return qp_raise_system_error(ctx, "invalid %s kind %d", d->name, kind);
        ct = d->sum + i;
        c = &qpast_types[ct];
    }
    result = qp_object_new_instance(ctx, qpast_type(cv->st, ct), JS_CLASS_PY_OBJECT);
    if (JS_IsException(result))
        return result;
    if (qpast_set_fields(cv, result, c->fields, c->nfields, node) < 0 ||
        qpast_set_fields(cv, result, d->attrs, d->nattrs, node) < 0) {
        JS_FreeValue(ctx, result);
        return JS_EXCEPTION;
    }
    return result;
}

/* ---- obj2ast -------------------------------------------------------------- */

static int qpast_obj2node(QPAstConv *cv, int t, JSValueConst obj, void **out);

/* obj2ast_int */
static int qpast_obj2int(JSContext *ctx, JSValueConst obj, int *out)
{
    JSValue v;
    int64_t x;
    int overflow;
    if (!qp_long_check(ctx, obj)) {
        qp_raise_value_error(ctx, "invalid integer value: %R", obj);
        return -1;
    }
    v = qp_long_value(ctx, obj);
    if (JS_IsException(v))
        return -1;
    qp_long_as_int64_overflow(v, &x, &overflow);
    JS_FreeValue(ctx, v);
    if (overflow || x < INT_MIN || x > INT_MAX) {
        qp_raise_overflow_error(ctx, "Python int too large to convert to C int");
        return -1;
    }
    *out = (int)x;
    return 0;
}

/* identifier / string value as an arena-owned atom */
static int qpast_obj2atom(QPAstConv *cv, JSValueConst obj, JSAtom *out)
{
    JSContext *ctx = cv->ctx;
    JSAtom a;
    if (qp_type_of(ctx, obj) == QP_TYPE(ctx, bytes)) {
        Py_ssize_t n;
        const uint8_t *data = qp_bytes_data(obj, &n);
        JSValue s = js_new_string8_len(ctx, (const char *)data, (int)n);
        if (JS_IsException(s))
            return -1;
        a = JS_ValueToAtom(ctx, s);
        JS_FreeValue(ctx, s);
    } else {
        a = qp_str_to_atom(ctx, obj);
    }
    if (a == JS_ATOM_NULL)
        return -1;
    if (qp_arena_add_atom(cv->arena, a) < 0) {
        qpast_raise_arena_error(ctx, cv->arena);
        return -1;
    }
    *out = a;
    return 0;
}

static int qpast_obj2elem(QPAstConv *cv, int type, JSValueConst obj, void *dst)
{
    JSContext *ctx = cv->ctx;
    switch (type) {
    case QPAST_B_IDENTIFIER:
        if (!qp_str_check_exact(obj) && !qpast_is_none(obj)) {
            qp_raise_type_error(ctx, "AST identifier must be of type str");
            return -1;
        }
        if (qpast_is_none(obj)) {
            *(JSAtom *)dst = JS_ATOM_NULL;
            return 0;
        }
        return qpast_obj2atom(cv, obj, (JSAtom *)dst);
    case QPAST_B_STRING:
        if (!qp_str_check_exact(obj) && qp_type_of(ctx, obj) != QP_TYPE(ctx, bytes)) {
            qp_raise_type_error(ctx, "AST string must be of type str");
            return -1;
        }
        return qpast_obj2atom(cv, obj, (JSAtom *)dst);
    case QPAST_B_INT:
        return qpast_obj2int(ctx, obj, (int *)dst);
    case QPAST_B_CONSTANT: {
        qp_const *c = qpast_obj2const(ctx, cv->arena, obj);
        if (!c)
            return -1;
        *(qp_const **)dst = c;
        return 0;
    }
    default:
        if (qpast_types[type].kind == QPAST_K_SIMPLE_SUM) {
            const QPAstTypeDesc *d = &qpast_types[type];
            int i;
            for (i = 0; i < d->ncons; i++) {
                int r = qp_isinstance(ctx, obj, cv->st[d->sum + i]);
                if (r < 0)
                    return -1;
                if (r) {
                    *(int *)dst = qpast_types[d->sum + i].value;
                    return 0;
                }
            }
            qp_raise_type_error(ctx, "expected some sort of %s, but got %R", d->name, obj);
            return -1;
        }
        return qpast_obj2node(cv, type, obj, (void **)dst);
    }
}

static int qpast_obj2field(QPAstConv *cv, const QPAstField *f, const char *owner,
                           JSValueConst obj, char *base)
{
    JSContext *ctx = cv->ctx;
    const char *name = qpast_names[f->name];
    char *p = base + f->offset;
    JSValue tmp;
    int r;

    r = qp_getattr_opt(ctx, obj, cv->atoms[f->name], &tmp);
    if (r < 0)
        return -1;
    if (f->flags & QPAST_F_SEQ) {
        Py_ssize_t len, i;
        asdl_seq *seq;
        char buf[64];
        if (r == 0) {
            tmp = qp_list_new(ctx, 0);
            if (JS_IsException(tmp))
                return -1;
        }
        if (!qp_list_check(ctx, tmp)) {
            qp_raise_type_error(ctx, "%s field \"%s\" must be a list, not a %.200s", owner, name,
                                qpast_short_name(ctx, qp_type_of(ctx, tmp), buf, sizeof(buf)));
            goto failed;
        }
        len = qp_list_size(tmp);
        if (f->type == QPAST_B_IDENTIFIER || f->type == QPAST_B_STRING)
            seq = (asdl_seq *)_Py_asdl_identifier_seq_new(len, cv->arena);
        else if (f->type == QPAST_B_INT ||
                 (f->type >= 0 && qpast_types[f->type].kind == QPAST_K_SIMPLE_SUM))
            seq = (asdl_seq *)_Py_asdl_int_seq_new(len, cv->arena);
        else
            seq = (asdl_seq *)_Py_asdl_generic_seq_new(len, cv->arena);
        if (!seq) {
            qpast_raise_arena_error(ctx, cv->arena);
            goto failed;
        }
        for (i = 0; i < len; i++) {
            JSValue tmp2 = qpast_list_item(ctx, tmp, i);
            int res;
            if (JS_IsException(tmp2))
                goto failed;
            if (qpast_check_stack(ctx, NULL, owner) < 0) {
                JS_FreeValue(ctx, tmp2);
                goto failed;
            }
            res = qpast_obj2elem(cv, f->type, tmp2, qpast_seq_elem(seq, f->type, i));
            JS_FreeValue(ctx, tmp2);
            if (res != 0)
                goto failed;
            if (len != qp_list_size(tmp)) {
                qp_raise_runtime_error(ctx, "%s field \"%s\" changed size during iteration",
                                       owner, name);
                goto failed;
            }
        }
        *(asdl_seq **)p = seq;
        JS_FreeValue(ctx, tmp);
        return 0;
    }
    if (r == 0 && !(f->flags & QPAST_F_OPT)) {
        qp_raise_type_error(ctx, "required field \"%s\" missing from %s", name, owner);
        return -1;
    }
    if ((f->flags & QPAST_F_OPT) && (r == 0 || qpast_is_none(tmp))) {
        if (r != 0)
            JS_FreeValue(ctx, tmp);
        if (f->type == QPAST_B_INT)
            *(int *)p = f->dflt >= 0 ? *(const int *)(base + f->dflt) : 0;
        else if (f->type == QPAST_B_IDENTIFIER || f->type == QPAST_B_STRING)
            *(JSAtom *)p = JS_ATOM_NULL;
        else
            *(void **)p = NULL;
        return 0;
    }
    if (qpast_check_stack(ctx, NULL, owner) < 0)
        goto failed;
    r = qpast_obj2elem(cv, f->type, tmp, p);
    JS_FreeValue(ctx, tmp);
    return r;
failed:
    JS_FreeValue(ctx, tmp);
    return -1;
}

static int qpast_obj2fields(QPAstConv *cv, int first, int n, const char *owner,
                            JSValueConst obj, char *base)
{
    int i;
    for (i = 0; i < n; i++) {
        if (qpast_obj2field(cv, &qpast_fields[first + i], owner, obj, base) < 0)
            return -1;
    }
    return 0;
}

/* The _PyAST_<Node>() constructor checks: ValueError "field '%s' is
   required for %s" for a required node / identifier / constant field that
   ended up NULL (the object had None). */
static int qpast_check_required(JSContext *ctx, int t, const char *base)
{
    const QPAstTypeDesc *d = &qpast_types[t];
    int i;
    for (i = 0; i < d->nfields; i++) {
        const QPAstField *f = &qpast_fields[d->fields + i];
        const char *p = base + f->offset;
        BOOL missing;
        if (f->flags & (QPAST_F_SEQ | QPAST_F_OPT))
            continue;
        if (f->type == QPAST_B_INT ||
            (f->type >= 0 && qpast_types[f->type].kind == QPAST_K_SIMPLE_SUM))
            continue;
        if (f->type == QPAST_B_IDENTIFIER || f->type == QPAST_B_STRING)
            missing = *(const JSAtom *)p == JS_ATOM_NULL;
        else
            missing = *(void *const *)p == NULL;
        if (missing) {
            qp_raise_value_error(ctx, "field '%s' is required for %s", qpast_names[f->name],
                                 d->name);
            return -1;
        }
    }
    return 0;
}

static int qpast_obj2node(QPAstConv *cv, int t, JSValueConst obj, void **out)
{
    JSContext *ctx = cv->ctx;
    const QPAstTypeDesc *d = &qpast_types[t];
    char *node;
    int i;

    *out = NULL;
    if (d->kind == QPAST_K_SUM && qpast_is_none(obj))
        return 0;
    node = qp_arena_malloc(cv->arena, d->size);
    if (!node) {
        qpast_raise_arena_error(ctx, cv->arena);
        return -1;
    }
    memset(node, 0, d->size);
    if (d->kind == QPAST_K_PRODUCT) {
        if (qpast_obj2fields(cv, d->fields, d->nfields, d->name, obj, node) < 0 ||
            qpast_obj2fields(cv, d->attrs, d->nattrs, d->name, obj, node) < 0 ||
            qpast_check_required(ctx, t, node) < 0)
            return -1;
        *out = node;
        return 0;
    }
    if (qpast_obj2fields(cv, d->attrs, d->nattrs, d->name, obj, node) < 0)
        return -1;
    for (i = 0; i < d->ncons; i++) {
        int c = d->sum + i;
        const QPAstTypeDesc *cd = &qpast_types[c];
        int r = qp_isinstance(ctx, obj, cv->st[c]);
        if (r < 0)
            return -1;
        if (r) {
            *(int *)(node + d->kind_offset) = cd->value;
            if (qpast_obj2fields(cv, cd->fields, cd->nfields, cd->name, obj, node) < 0 ||
                qpast_check_required(ctx, c, node) < 0)
                return -1;
            *out = node;
            return 0;
        }
    }
    qp_raise_type_error(ctx, "expected some sort of %s, but got %R", d->name, obj);
    return -1;
}

/* ---- _PyAST_Validate (Python/ast.c) -------------------------------------- */

static int qpast_v_stmts(JSContext *ctx, asdl_stmt_seq *seq);
static int qpast_v_exprs(JSContext *ctx, asdl_expr_seq *exprs, expr_context_ty ectx, int null_ok);
static int qpast_v_patterns(JSContext *ctx, asdl_pattern_seq *patterns, int star_ok);
static int qpast_v_type_params(JSContext *ctx, asdl_type_param_seq *tps);
static int qpast_v_stmt(JSContext *ctx, stmt_ty stmt);
static int qpast_v_expr(JSContext *ctx, expr_ty exp, expr_context_ty ectx);
static int qpast_v_pattern(JSContext *ctx, pattern_ty p, int star_ok);

#define QPAST_VALIDATE_POSITIONS(node)                                        \
    if ((node)->lineno > (node)->end_lineno) {                                \
        qp_raise_value_error(ctx, "AST node line range (%d, %d) is not valid", \
                             (node)->lineno, (node)->end_lineno);             \
        return 0;                                                             \
    }                                                                         \
    if (((node)->lineno < 0 && (node)->end_lineno != (node)->lineno) ||       \
        ((node)->col_offset < 0 && (node)->col_offset != (node)->end_col_offset)) { \
        qp_raise_value_error(ctx, "AST node column range (%d, %d) for line range (%d, %d) is not valid", \
                             (node)->col_offset, (node)->end_col_offset,      \
                             (node)->lineno, (node)->end_lineno);             \
        return 0;                                                             \
    }                                                                         \
    if ((node)->lineno == (node)->end_lineno && (node)->col_offset > (node)->end_col_offset) { \
        qp_raise_value_error(ctx, "line %d, column %d-%d is not a valid range", \
                             (node)->lineno, (node)->col_offset, (node)->end_col_offset); \
        return 0;                                                             \
    }

/* ENTER_RECURSIVE() of Python/ast.c */
#define QPAST_V_ENTER()                                                       \
    if (qpast_check_stack(ctx, " during compilation", NULL) < 0)              \
        return 0;

/* _PyUnicode_EqualToASCIIString on an identifier */
static BOOL qpast_atom_eq(JSContext *ctx, JSAtom a, const char *s)
{
    char buf[64];
    if (a == JS_ATOM_NULL)
        return FALSE;
    return strcmp(JS_AtomGetStr(ctx, buf, sizeof(buf), a), s) == 0;
}

static int qpast_v_name(JSContext *ctx, JSAtom name)
{
    static const char *const forbidden[] = { "None", "True", "False", NULL };
    int i;
    for (i = 0; forbidden[i] != NULL; i++) {
        if (qpast_atom_eq(ctx, name, forbidden[i])) {
            qp_raise_value_error(ctx, "identifier field can't represent '%s' constant",
                                 forbidden[i]);
            return 0;
        }
    }
    return 1;
}

static int qpast_v_comprehension(JSContext *ctx, asdl_comprehension_seq *gens)
{
    Py_ssize_t i;
    if (!asdl_seq_LEN(gens)) {
        qp_raise_value_error(ctx, "comprehension with no generators");
        return 0;
    }
    for (i = 0; i < asdl_seq_LEN(gens); i++) {
        comprehension_ty comp = asdl_seq_GET(gens, i);
        if (!qpast_v_expr(ctx, comp->target, Store) ||
            !qpast_v_expr(ctx, comp->iter, Load) ||
            !qpast_v_exprs(ctx, comp->ifs, Load, 0))
            return 0;
    }
    return 1;
}

static int qpast_v_keywords(JSContext *ctx, asdl_keyword_seq *keywords)
{
    Py_ssize_t i;
    for (i = 0; i < asdl_seq_LEN(keywords); i++)
        if (!qpast_v_expr(ctx, (asdl_seq_GET(keywords, i))->value, Load))
            return 0;
    return 1;
}

static int qpast_v_args(JSContext *ctx, asdl_arg_seq *args)
{
    Py_ssize_t i;
    for (i = 0; i < asdl_seq_LEN(args); i++) {
        arg_ty arg = asdl_seq_GET(args, i);
        QPAST_VALIDATE_POSITIONS(arg);
        if (arg->annotation && !qpast_v_expr(ctx, arg->annotation, Load))
            return 0;
    }
    return 1;
}

static const char *qpast_expr_context_name(expr_context_ty ectx)
{
    switch (ectx) {
    case Load:
        return "Load";
    case Store:
        return "Store";
    case Del:
        return "Del";
    }
    return "?";
}

static int qpast_v_arguments(JSContext *ctx, arguments_ty args)
{
    if (!qpast_v_args(ctx, args->posonlyargs) || !qpast_v_args(ctx, args->args))
        return 0;
    if (args->vararg && args->vararg->annotation
        && !qpast_v_expr(ctx, args->vararg->annotation, Load))
        return 0;
    if (!qpast_v_args(ctx, args->kwonlyargs))
        return 0;
    if (args->kwarg && args->kwarg->annotation
        && !qpast_v_expr(ctx, args->kwarg->annotation, Load))
        return 0;
    if (asdl_seq_LEN(args->defaults) > asdl_seq_LEN(args->posonlyargs) + asdl_seq_LEN(args->args)) {
        qp_raise_value_error(ctx, "more positional defaults than args on arguments");
        return 0;
    }
    if (asdl_seq_LEN(args->kw_defaults) != asdl_seq_LEN(args->kwonlyargs)) {
        qp_raise_value_error(ctx, "length of kwonlyargs is not the same as "
                             "kw_defaults on arguments");
        return 0;
    }
    return qpast_v_exprs(ctx, args->defaults, Load, 0) &&
           qpast_v_exprs(ctx, args->kw_defaults, Load, 1);
}

static BOOL qpast_is_exact(JSContext *ctx, JSValueConst v, QPType *t)
{
    return qp_type_of(ctx, v) == t;
}

/* validate_constant on a Python value */
static int qpast_v_constant_value(JSContext *ctx, JSValueConst value)
{
    QPType *tp;
    char buf[64];

    if (qpast_is_none(value) ||
        (JS_VALUE_GET_TAG(value) == JS_TAG_OBJECT &&
         JS_VALUE_GET_PTR(value) == JS_VALUE_GET_PTR(QP_STATE(ctx)->ellipsis)))
        return 1;
    tp = qp_type_of(ctx, value);
    if (tp == QP_TYPE(ctx, int) || tp == QP_TYPE(ctx, float) || tp == QP_TYPE(ctx, complex) ||
        tp == QP_TYPE(ctx, bool) || tp == QP_TYPE(ctx, str) || tp == QP_TYPE(ctx, bytes))
        return 1;
    if (tp == QP_TYPE(ctx, tuple) || tp == QP_TYPE(ctx, frozenset)) {
        JSValue it, item;
        QPAST_V_ENTER();
        it = qp_iter(ctx, value);
        if (JS_IsException(it))
            return 0;
        for (;;) {
            item = qp_next(ctx, it);
            if (JS_IsException(item)) {
                JS_FreeValue(ctx, it);
                return 0;
            }
            if (QP_IS_NULL(item))
                break;
            if (!qpast_v_constant_value(ctx, item)) {
                JS_FreeValue(ctx, it);
                JS_FreeValue(ctx, item);
                return 0;
            }
            JS_FreeValue(ctx, item);
        }
        JS_FreeValue(ctx, it);
        return 1;
    }
    qp_raise_type_error(ctx, "got an invalid type in Constant: %s",
                        qpast_short_name(ctx, tp, buf, sizeof(buf)));
    return 0;
}

static int qpast_v_constant(JSContext *ctx, const qp_const *c)
{
    if (c->kind != QP_CONST_OBJECT)
        return 1;
    return qpast_v_constant_value(ctx, c->v);
}

/* PyComplex_CheckExact on a constant */
static BOOL qpast_const_is_complex(JSContext *ctx, const qp_const *c)
{
    return c->kind == QP_CONST_COMPLEX ||
           (c->kind == QP_CONST_OBJECT && qpast_is_exact(ctx, c->v, QP_TYPE(ctx, complex)));
}

static int qpast_v_expr(JSContext *ctx, expr_ty exp, expr_context_ty ectx)
{
    int ret = -1;
    int check_ctx = 1;
    expr_context_ty actual_ctx;

    QPAST_VALIDATE_POSITIONS(exp);
    QPAST_V_ENTER();
    /* First check expression context. */
    switch (exp->kind) {
    case Attribute_kind:
        actual_ctx = exp->v.Attribute.ctx;
        break;
    case Subscript_kind:
        actual_ctx = exp->v.Subscript.ctx;
        break;
    case Starred_kind:
        actual_ctx = exp->v.Starred.ctx;
        break;
    case Name_kind:
        if (!qpast_v_name(ctx, exp->v.Name.id))
            return 0;
        actual_ctx = exp->v.Name.ctx;
        break;
    case List_kind:
        actual_ctx = exp->v.List.ctx;
        break;
    case Tuple_kind:
        actual_ctx = exp->v.Tuple.ctx;
        break;
    default:
        if (ectx != Load) {
            qp_raise_value_error(ctx, "expression which can't be assigned to in %s context",
                                 qpast_expr_context_name(ectx));
            return 0;
        }
        check_ctx = 0;
        actual_ctx = 0;
    }
    if (check_ctx && actual_ctx != ectx) {
        qp_raise_value_error(ctx, "expression must have %s context but has %s instead",
                             qpast_expr_context_name(ectx), qpast_expr_context_name(actual_ctx));
        return 0;
    }

    /* Now validate expression. */
    switch (exp->kind) {
    case BoolOp_kind:
        if (asdl_seq_LEN(exp->v.BoolOp.values) < 2) {
            qp_raise_value_error(ctx, "BoolOp with less than 2 values");
            return 0;
        }
        ret = qpast_v_exprs(ctx, exp->v.BoolOp.values, Load, 0);
        break;
    case BinOp_kind:
        ret = qpast_v_expr(ctx, exp->v.BinOp.left, Load) &&
              qpast_v_expr(ctx, exp->v.BinOp.right, Load);
        break;
    case UnaryOp_kind:
        ret = qpast_v_expr(ctx, exp->v.UnaryOp.operand, Load);
        break;
    case Lambda_kind:
        ret = qpast_v_arguments(ctx, exp->v.Lambda.args) &&
              qpast_v_expr(ctx, exp->v.Lambda.body, Load);
        break;
    case IfExp_kind:
        ret = qpast_v_expr(ctx, exp->v.IfExp.test, Load) &&
              qpast_v_expr(ctx, exp->v.IfExp.body, Load) &&
              qpast_v_expr(ctx, exp->v.IfExp.orelse, Load);
        break;
    case Dict_kind:
        if (asdl_seq_LEN(exp->v.Dict.keys) != asdl_seq_LEN(exp->v.Dict.values)) {
            qp_raise_value_error(ctx, "Dict doesn't have the same number of keys as values");
            return 0;
        }
        /* null_ok=1 for keys expressions to allow dict unpacking to work in
           dict literals, i.e. ``{**{a:b}}`` */
        ret = qpast_v_exprs(ctx, exp->v.Dict.keys, Load, 1) &&
              qpast_v_exprs(ctx, exp->v.Dict.values, Load, 0);
        break;
    case Set_kind:
        ret = qpast_v_exprs(ctx, exp->v.Set.elts, Load, 0);
        break;
    case ListComp_kind:
        ret = qpast_v_comprehension(ctx, exp->v.ListComp.generators) &&
              qpast_v_expr(ctx, exp->v.ListComp.elt, Load);
        break;
    case SetComp_kind:
        ret = qpast_v_comprehension(ctx, exp->v.SetComp.generators) &&
              qpast_v_expr(ctx, exp->v.SetComp.elt, Load);
        break;
    case GeneratorExp_kind:
        ret = qpast_v_comprehension(ctx, exp->v.GeneratorExp.generators) &&
              qpast_v_expr(ctx, exp->v.GeneratorExp.elt, Load);
        break;
    case DictComp_kind:
        ret = qpast_v_comprehension(ctx, exp->v.DictComp.generators) &&
              qpast_v_expr(ctx, exp->v.DictComp.key, Load);
        if (ret && exp->v.DictComp.value != NULL)
            ret = qpast_v_expr(ctx, exp->v.DictComp.value, Load);
        break;
    case Yield_kind:
        ret = !exp->v.Yield.value || qpast_v_expr(ctx, exp->v.Yield.value, Load);
        break;
    case YieldFrom_kind:
        ret = qpast_v_expr(ctx, exp->v.YieldFrom.value, Load);
        break;
    case Await_kind:
        ret = qpast_v_expr(ctx, exp->v.Await.value, Load);
        break;
    case Compare_kind:
        if (!asdl_seq_LEN(exp->v.Compare.comparators)) {
            qp_raise_value_error(ctx, "Compare with no comparators");
            return 0;
        }
        if (asdl_seq_LEN(exp->v.Compare.comparators) != asdl_seq_LEN(exp->v.Compare.ops)) {
            qp_raise_value_error(ctx, "Compare has a different number "
                                 "of comparators and operands");
            return 0;
        }
        ret = qpast_v_exprs(ctx, exp->v.Compare.comparators, Load, 0) &&
              qpast_v_expr(ctx, exp->v.Compare.left, Load);
        break;
    case Call_kind:
        ret = qpast_v_expr(ctx, exp->v.Call.func, Load) &&
              qpast_v_exprs(ctx, exp->v.Call.args, Load, 0) &&
              qpast_v_keywords(ctx, exp->v.Call.keywords);
        break;
    case Constant_kind:
        if (!qpast_v_constant(ctx, exp->v.Constant.value))
            return 0;
        ret = 1;
        break;
    case JoinedStr_kind:
        ret = qpast_v_exprs(ctx, exp->v.JoinedStr.values, Load, 0);
        break;
    case TemplateStr_kind:
        ret = qpast_v_exprs(ctx, exp->v.TemplateStr.values, Load, 0);
        break;
    case FormattedValue_kind:
        if (qpast_v_expr(ctx, exp->v.FormattedValue.value, Load) == 0)
            return 0;
        if (exp->v.FormattedValue.format_spec) {
            ret = qpast_v_expr(ctx, exp->v.FormattedValue.format_spec, Load);
            break;
        }
        ret = 1;
        break;
    case Interpolation_kind:
        if (qpast_v_expr(ctx, exp->v.Interpolation.value, Load) == 0)
            return 0;
        if (exp->v.Interpolation.format_spec) {
            ret = qpast_v_expr(ctx, exp->v.Interpolation.format_spec, Load);
            break;
        }
        ret = 1;
        break;
    case Attribute_kind:
        ret = qpast_v_expr(ctx, exp->v.Attribute.value, Load);
        break;
    case Subscript_kind:
        ret = qpast_v_expr(ctx, exp->v.Subscript.slice, Load) &&
              qpast_v_expr(ctx, exp->v.Subscript.value, Load);
        break;
    case Starred_kind:
        ret = qpast_v_expr(ctx, exp->v.Starred.value, ectx);
        break;
    case Slice_kind:
        ret = (!exp->v.Slice.lower || qpast_v_expr(ctx, exp->v.Slice.lower, Load)) &&
              (!exp->v.Slice.upper || qpast_v_expr(ctx, exp->v.Slice.upper, Load)) &&
              (!exp->v.Slice.step || qpast_v_expr(ctx, exp->v.Slice.step, Load));
        break;
    case List_kind:
        ret = qpast_v_exprs(ctx, exp->v.List.elts, ectx, 0);
        break;
    case Tuple_kind:
        ret = qpast_v_exprs(ctx, exp->v.Tuple.elts, ectx, 0);
        break;
    case NamedExpr_kind:
        if (exp->v.NamedExpr.target->kind != Name_kind) {
            qp_raise_type_error(ctx, "NamedExpr target must be a Name");
            return 0;
        }
        ret = qpast_v_expr(ctx, exp->v.NamedExpr.value, Load);
        break;
    /* This last case doesn't have any checking. */
    case Name_kind:
        ret = 1;
        break;
    }
    if (ret < 0) {
        qp_raise_system_error(ctx, "unexpected expression");
        ret = 0;
    }
    return ret;
}

/* The ensure_literal_* functions only validate a restricted set of
   non-recursive literals already checked by qpast_v_expr. */
static int qpast_ensure_literal_number(JSContext *ctx, expr_ty exp, BOOL allow_real,
                                       BOOL allow_imaginary)
{
    const qp_const *c = exp->v.Constant.value;
    return (allow_real && c->kind == QP_CONST_FLOAT) ||
           (allow_real && c->kind == QP_CONST_INT) ||
           (allow_imaginary && qpast_const_is_complex(ctx, c));
}

static int qpast_ensure_literal_signed(JSContext *ctx, expr_ty exp, BOOL allow_real,
                                       BOOL allow_imaginary)
{
    expr_ty operand;
    /* Must be negation or positive ... */
    if (exp->v.UnaryOp.op != USub && exp->v.UnaryOp.op != UAdd)
        return 0;
    /* ... of a constant ... */
    operand = exp->v.UnaryOp.operand;
    if (operand->kind != Constant_kind)
        return 0;
    /* ... number */
    return qpast_ensure_literal_number(ctx, operand, allow_real, allow_imaginary);
}

static int qpast_ensure_literal_complex(JSContext *ctx, expr_ty exp)
{
    expr_ty left = exp->v.BinOp.left;
    expr_ty right = exp->v.BinOp.right;
    /* Ensure op is addition or subtraction */
    if (exp->v.BinOp.op != Add && exp->v.BinOp.op != Sub)
        return 0;
    /* Check LHS is a real number (potentially signed) */
    switch (left->kind) {
    case Constant_kind:
        if (!qpast_ensure_literal_number(ctx, left, TRUE, FALSE))
            return 0;
        break;
    case UnaryOp_kind:
        if (!qpast_ensure_literal_signed(ctx, left, TRUE, FALSE))
            return 0;
        break;
    default:
        return 0;
    }
    /* Check RHS is an imaginary number (no separate sign allowed) */
    switch (right->kind) {
    case Constant_kind:
        if (!qpast_ensure_literal_number(ctx, right, FALSE, TRUE))
            return 0;
        break;
    default:
        return 0;
    }
    return 1;
}

static int qpast_v_pattern_match_value(JSContext *ctx, expr_ty exp)
{
    if (!qpast_v_expr(ctx, exp, Load))
        return 0;
    switch (exp->kind) {
    case Constant_kind: {
        /* Ellipsis and immutable sequences are not allowed.  For True,
           False and None, MatchSingleton() should be used */
        const qp_const *literal;
        if (!qpast_v_expr(ctx, exp, Load))
            return 0;
        literal = exp->v.Constant.value;
        if (literal->kind == QP_CONST_INT || literal->kind == QP_CONST_FLOAT ||
            literal->kind == QP_CONST_BYTES || qpast_const_is_complex(ctx, literal) ||
            literal->kind == QP_CONST_STR)
            return 1;
        qp_raise_value_error(ctx, "unexpected constant inside of a literal pattern");
        return 0;
    }
    case Attribute_kind:
        /* Constants and attribute lookups are always permitted */
        return 1;
    case UnaryOp_kind:
        /* Signed numbers are permitted (whether real or imaginary) */
        if (qpast_ensure_literal_signed(ctx, exp, TRUE, TRUE))
            return 1;
        break;
    case BinOp_kind:
        /* Complex literals are permitted */
        if (qpast_ensure_literal_complex(ctx, exp))
            return 1;
        break;
    case JoinedStr_kind:
    case TemplateStr_kind:
        /* Handled in the later stages */
        return 1;
    default:
        break;
    }
    qp_raise_value_error(ctx, "patterns may only match literals and attribute lookups");
    return 0;
}

static int qpast_v_capture(JSContext *ctx, JSAtom name)
{
    if (qpast_atom_eq(ctx, name, "_")) {
        qp_raise_value_error(ctx, "can't capture name '_' in patterns");
        return 0;
    }
    return qpast_v_name(ctx, name);
}

static int qpast_v_pattern(JSContext *ctx, pattern_ty p, int star_ok)
{
    int ret = -1;
    Py_ssize_t i;

    QPAST_VALIDATE_POSITIONS(p);
    QPAST_V_ENTER();
    switch (p->kind) {
    case MatchValue_kind:
        ret = qpast_v_pattern_match_value(ctx, p->v.MatchValue.value);
        break;
    case MatchSingleton_kind: {
        qp_const_kind k = p->v.MatchSingleton.value->kind;
        ret = k == QP_CONST_NONE || k == QP_CONST_TRUE || k == QP_CONST_FALSE;
        if (!ret)
            qp_raise_value_error(ctx, "MatchSingleton can only contain True, False and None");
        break;
    }
    case MatchSequence_kind:
        ret = qpast_v_patterns(ctx, p->v.MatchSequence.patterns, 1);
        break;
    case MatchMapping_kind: {
        asdl_expr_seq *keys;
        if (asdl_seq_LEN(p->v.MatchMapping.keys) != asdl_seq_LEN(p->v.MatchMapping.patterns)) {
            qp_raise_value_error(ctx, "MatchMapping doesn't have the same number of keys as patterns");
            ret = 0;
            break;
        }
        if (p->v.MatchMapping.rest && !qpast_v_capture(ctx, p->v.MatchMapping.rest)) {
            ret = 0;
            break;
        }
        keys = p->v.MatchMapping.keys;
        for (i = 0; i < asdl_seq_LEN(keys); i++) {
            expr_ty key = asdl_seq_GET(keys, i);
            if (key->kind == Constant_kind) {
                qp_const_kind k = key->v.Constant.value->kind;
                if (k == QP_CONST_NONE || k == QP_CONST_TRUE || k == QP_CONST_FALSE) {
                    /* syntactically valid: passed on in a special case */
                    continue;
                }
            }
            if (!qpast_v_pattern_match_value(ctx, key)) {
                ret = 0;
                break;
            }
        }
        if (ret == 0)
            break;
        ret = qpast_v_patterns(ctx, p->v.MatchMapping.patterns, 0);
        break;
    }
    case MatchClass_kind: {
        expr_ty cls;
        if (asdl_seq_LEN(p->v.MatchClass.kwd_attrs) != asdl_seq_LEN(p->v.MatchClass.kwd_patterns)) {
            qp_raise_value_error(ctx, "MatchClass doesn't have the same number of keyword attributes as patterns");
            ret = 0;
            break;
        }
        if (!qpast_v_expr(ctx, p->v.MatchClass.cls, Load)) {
            ret = 0;
            break;
        }
        cls = p->v.MatchClass.cls;
        for (;;) {
            if (cls->kind == Name_kind) {
                break;
            } else if (cls->kind == Attribute_kind) {
                cls = cls->v.Attribute.value;
                continue;
            } else {
                qp_raise_value_error(ctx, "MatchClass cls field can only contain Name or Attribute nodes.");
                ret = 0;
                break;
            }
        }
        if (ret == 0)
            break;
        for (i = 0; i < asdl_seq_LEN(p->v.MatchClass.kwd_attrs); i++) {
            JSAtom identifier = asdl_seq_GET(p->v.MatchClass.kwd_attrs, i);
            if (!qpast_v_name(ctx, identifier)) {
                ret = 0;
                break;
            }
        }
        if (ret == 0)
            break;
        if (!qpast_v_patterns(ctx, p->v.MatchClass.patterns, 0)) {
            ret = 0;
            break;
        }
        ret = qpast_v_patterns(ctx, p->v.MatchClass.kwd_patterns, 0);
        break;
    }
    case MatchStar_kind:
        if (!star_ok) {
            qp_raise_value_error(ctx, "can't use MatchStar here");
            ret = 0;
            break;
        }
        ret = p->v.MatchStar.name == JS_ATOM_NULL || qpast_v_capture(ctx, p->v.MatchStar.name);
        break;
    case MatchAs_kind:
        if (p->v.MatchAs.name && !qpast_v_capture(ctx, p->v.MatchAs.name)) {
            ret = 0;
            break;
        }
        if (p->v.MatchAs.pattern == NULL) {
            ret = 1;
        } else if (p->v.MatchAs.name == JS_ATOM_NULL) {
            qp_raise_value_error(ctx, "MatchAs must specify a target name if a pattern is given");
            ret = 0;
        } else {
            ret = qpast_v_pattern(ctx, p->v.MatchAs.pattern, 0);
        }
        break;
    case MatchOr_kind:
        if (asdl_seq_LEN(p->v.MatchOr.patterns) < 2) {
            qp_raise_value_error(ctx, "MatchOr requires at least 2 patterns");
            ret = 0;
            break;
        }
        ret = qpast_v_patterns(ctx, p->v.MatchOr.patterns, 0);
        break;
    }
    if (ret < 0) {
        qp_raise_system_error(ctx, "unexpected pattern");
        ret = 0;
    }
    return ret;
}

static int qpast_v_nonempty_seq(JSContext *ctx, Py_ssize_t len, const char *what,
                                const char *owner)
{
    if (len)
        return 1;
    qp_raise_value_error(ctx, "empty %s on %s", what, owner);
    return 0;
}

static int qpast_v_import_names(JSContext *ctx, asdl_alias_seq *seq, const char *what,
                                const char *owner)
{
    Py_ssize_t i, n;
    if (!qpast_v_nonempty_seq(ctx, asdl_seq_LEN(seq), what, owner))
        return 0;
    n = asdl_seq_LEN(seq);
    for (i = 0; i < n; i++) {
        alias_ty alias = asdl_seq_GET(seq, i);
        if (!qpast_v_name(ctx, alias->name) ||
            (alias->asname && !qpast_v_name(ctx, alias->asname)))
            return 0;
    }
    return 1;
}

static int qpast_v_assignlist(JSContext *ctx, asdl_expr_seq *targets, expr_context_ty ectx)
{
    return qpast_v_nonempty_seq(ctx, asdl_seq_LEN(targets), "targets",
                                ectx == Del ? "Delete" : "Assign") &&
           qpast_v_exprs(ctx, targets, ectx, 0);
}

static int qpast_v_body(JSContext *ctx, asdl_stmt_seq *body, const char *owner)
{
    return qpast_v_nonempty_seq(ctx, asdl_seq_LEN(body), "body", owner) &&
           qpast_v_stmts(ctx, body);
}

static int qpast_v_stmt(JSContext *ctx, stmt_ty stmt)
{
    int ret = -1;
    Py_ssize_t i;

    QPAST_VALIDATE_POSITIONS(stmt);
    QPAST_V_ENTER();
    switch (stmt->kind) {
    case FunctionDef_kind:
        ret = qpast_v_body(ctx, stmt->v.FunctionDef.body, "FunctionDef") &&
              qpast_v_name(ctx, stmt->v.FunctionDef.name) &&
              qpast_v_type_params(ctx, stmt->v.FunctionDef.type_params) &&
              qpast_v_arguments(ctx, stmt->v.FunctionDef.args) &&
              qpast_v_exprs(ctx, stmt->v.FunctionDef.decorator_list, Load, 0) &&
              (!stmt->v.FunctionDef.returns ||
               qpast_v_expr(ctx, stmt->v.FunctionDef.returns, Load));
        break;
    case ClassDef_kind:
        ret = qpast_v_body(ctx, stmt->v.ClassDef.body, "ClassDef") &&
              qpast_v_name(ctx, stmt->v.ClassDef.name) &&
              qpast_v_type_params(ctx, stmt->v.ClassDef.type_params) &&
              qpast_v_exprs(ctx, stmt->v.ClassDef.bases, Load, 0) &&
              qpast_v_keywords(ctx, stmt->v.ClassDef.keywords) &&
              qpast_v_exprs(ctx, stmt->v.ClassDef.decorator_list, Load, 0);
        break;
    case Return_kind:
        ret = !stmt->v.Return.value || qpast_v_expr(ctx, stmt->v.Return.value, Load);
        break;
    case Delete_kind:
        ret = qpast_v_assignlist(ctx, stmt->v.Delete.targets, Del);
        break;
    case Assign_kind:
        ret = qpast_v_assignlist(ctx, stmt->v.Assign.targets, Store) &&
              qpast_v_expr(ctx, stmt->v.Assign.value, Load);
        break;
    case AugAssign_kind:
        ret = qpast_v_expr(ctx, stmt->v.AugAssign.target, Store) &&
              qpast_v_expr(ctx, stmt->v.AugAssign.value, Load);
        break;
    case AnnAssign_kind:
        if (stmt->v.AnnAssign.target->kind != Name_kind && stmt->v.AnnAssign.simple) {
            qp_raise_type_error(ctx, "AnnAssign with simple non-Name target");
            return 0;
        }
        ret = qpast_v_expr(ctx, stmt->v.AnnAssign.target, Store) &&
              (!stmt->v.AnnAssign.value ||
               qpast_v_expr(ctx, stmt->v.AnnAssign.value, Load)) &&
              qpast_v_expr(ctx, stmt->v.AnnAssign.annotation, Load);
        break;
    case TypeAlias_kind:
        if (stmt->v.TypeAlias.name->kind != Name_kind) {
            qp_raise_type_error(ctx, "TypeAlias with non-Name name");
            return 0;
        }
        ret = qpast_v_expr(ctx, stmt->v.TypeAlias.name, Store) &&
              qpast_v_type_params(ctx, stmt->v.TypeAlias.type_params) &&
              qpast_v_expr(ctx, stmt->v.TypeAlias.value, Load);
        break;
    case For_kind:
        ret = qpast_v_expr(ctx, stmt->v.For.target, Store) &&
              qpast_v_expr(ctx, stmt->v.For.iter, Load) &&
              qpast_v_body(ctx, stmt->v.For.body, "For") &&
              qpast_v_stmts(ctx, stmt->v.For.orelse);
        break;
    case AsyncFor_kind:
        ret = qpast_v_expr(ctx, stmt->v.AsyncFor.target, Store) &&
              qpast_v_expr(ctx, stmt->v.AsyncFor.iter, Load) &&
              qpast_v_body(ctx, stmt->v.AsyncFor.body, "AsyncFor") &&
              qpast_v_stmts(ctx, stmt->v.AsyncFor.orelse);
        break;
    case While_kind:
        ret = qpast_v_expr(ctx, stmt->v.While.test, Load) &&
              qpast_v_body(ctx, stmt->v.While.body, "While") &&
              qpast_v_stmts(ctx, stmt->v.While.orelse);
        break;
    case If_kind:
        ret = qpast_v_expr(ctx, stmt->v.If.test, Load) &&
              qpast_v_body(ctx, stmt->v.If.body, "If") &&
              qpast_v_stmts(ctx, stmt->v.If.orelse);
        break;
    case With_kind:
        if (!qpast_v_nonempty_seq(ctx, asdl_seq_LEN(stmt->v.With.items), "items", "With"))
            return 0;
        for (i = 0; i < asdl_seq_LEN(stmt->v.With.items); i++) {
            withitem_ty item = asdl_seq_GET(stmt->v.With.items, i);
            if (!qpast_v_expr(ctx, item->context_expr, Load) ||
                (item->optional_vars && !qpast_v_expr(ctx, item->optional_vars, Store)))
                return 0;
        }
        ret = qpast_v_body(ctx, stmt->v.With.body, "With");
        break;
    case AsyncWith_kind:
        if (!qpast_v_nonempty_seq(ctx, asdl_seq_LEN(stmt->v.AsyncWith.items), "items",
                                  "AsyncWith"))
            return 0;
        for (i = 0; i < asdl_seq_LEN(stmt->v.AsyncWith.items); i++) {
            withitem_ty item = asdl_seq_GET(stmt->v.AsyncWith.items, i);
            if (!qpast_v_expr(ctx, item->context_expr, Load) ||
                (item->optional_vars && !qpast_v_expr(ctx, item->optional_vars, Store)))
                return 0;
        }
        ret = qpast_v_body(ctx, stmt->v.AsyncWith.body, "AsyncWith");
        break;
    case Match_kind:
        if (!qpast_v_expr(ctx, stmt->v.Match.subject, Load) ||
            !qpast_v_nonempty_seq(ctx, asdl_seq_LEN(stmt->v.Match.cases), "cases", "Match"))
            return 0;
        for (i = 0; i < asdl_seq_LEN(stmt->v.Match.cases); i++) {
            match_case_ty m = asdl_seq_GET(stmt->v.Match.cases, i);
            if (!qpast_v_pattern(ctx, m->pattern, 0) ||
                (m->guard && !qpast_v_expr(ctx, m->guard, Load)) ||
                !qpast_v_body(ctx, m->body, "match_case"))
                return 0;
        }
        ret = 1;
        break;
    case Raise_kind:
        if (stmt->v.Raise.exc) {
            ret = qpast_v_expr(ctx, stmt->v.Raise.exc, Load) &&
                  (!stmt->v.Raise.cause || qpast_v_expr(ctx, stmt->v.Raise.cause, Load));
            break;
        }
        if (stmt->v.Raise.cause) {
            qp_raise_value_error(ctx, "Raise with cause but no exception");
            return 0;
        }
        ret = 1;
        break;
    case Try_kind:
        if (!qpast_v_body(ctx, stmt->v.Try.body, "Try"))
            return 0;
        if (!asdl_seq_LEN(stmt->v.Try.handlers) && !asdl_seq_LEN(stmt->v.Try.finalbody)) {
            qp_raise_value_error(ctx, "Try has neither except handlers nor finalbody");
            return 0;
        }
        if (!asdl_seq_LEN(stmt->v.Try.handlers) && asdl_seq_LEN(stmt->v.Try.orelse)) {
            qp_raise_value_error(ctx, "Try has orelse but no except handlers");
            return 0;
        }
        for (i = 0; i < asdl_seq_LEN(stmt->v.Try.handlers); i++) {
            excepthandler_ty handler = asdl_seq_GET(stmt->v.Try.handlers, i);
            QPAST_VALIDATE_POSITIONS(handler);
            if ((handler->v.ExceptHandler.type &&
                 !qpast_v_expr(ctx, handler->v.ExceptHandler.type, Load)) ||
                (handler->v.ExceptHandler.name &&
                 !qpast_v_name(ctx, handler->v.ExceptHandler.name)) ||
                !qpast_v_body(ctx, handler->v.ExceptHandler.body, "ExceptHandler"))
                return 0;
        }
        ret = (!asdl_seq_LEN(stmt->v.Try.finalbody) ||
               qpast_v_stmts(ctx, stmt->v.Try.finalbody)) &&
              (!asdl_seq_LEN(stmt->v.Try.orelse) ||
               qpast_v_stmts(ctx, stmt->v.Try.orelse));
        break;
    case TryStar_kind:
        if (!qpast_v_body(ctx, stmt->v.TryStar.body, "TryStar"))
            return 0;
        if (!asdl_seq_LEN(stmt->v.TryStar.handlers) && !asdl_seq_LEN(stmt->v.TryStar.finalbody)) {
            qp_raise_value_error(ctx, "TryStar has neither except handlers nor finalbody");
            return 0;
        }
        if (!asdl_seq_LEN(stmt->v.TryStar.handlers) && asdl_seq_LEN(stmt->v.TryStar.orelse)) {
            qp_raise_value_error(ctx, "TryStar has orelse but no except handlers");
            return 0;
        }
        for (i = 0; i < asdl_seq_LEN(stmt->v.TryStar.handlers); i++) {
            excepthandler_ty handler = asdl_seq_GET(stmt->v.TryStar.handlers, i);
            if ((handler->v.ExceptHandler.type &&
                 !qpast_v_expr(ctx, handler->v.ExceptHandler.type, Load)) ||
                !qpast_v_body(ctx, handler->v.ExceptHandler.body, "ExceptHandler"))
                return 0;
        }
        ret = (!asdl_seq_LEN(stmt->v.TryStar.finalbody) ||
               qpast_v_stmts(ctx, stmt->v.TryStar.finalbody)) &&
              (!asdl_seq_LEN(stmt->v.TryStar.orelse) ||
               qpast_v_stmts(ctx, stmt->v.TryStar.orelse));
        break;
    case Assert_kind:
        ret = qpast_v_expr(ctx, stmt->v.Assert.test, Load) &&
              (!stmt->v.Assert.msg || qpast_v_expr(ctx, stmt->v.Assert.msg, Load));
        break;
    case Import_kind:
        ret = qpast_v_import_names(ctx, stmt->v.Import.names, "names", "Import");
        break;
    case ImportFrom_kind:
        if (stmt->v.ImportFrom.level < 0) {
            qp_raise_value_error(ctx, "Negative ImportFrom level");
            return 0;
        }
        ret = qpast_v_import_names(ctx, stmt->v.ImportFrom.names, "names", "ImportFrom");
        break;
    case Global_kind:
        ret = qpast_v_nonempty_seq(ctx, asdl_seq_LEN(stmt->v.Global.names), "names", "Global");
        break;
    case Nonlocal_kind:
        ret = qpast_v_nonempty_seq(ctx, asdl_seq_LEN(stmt->v.Nonlocal.names), "names",
                                   "Nonlocal");
        break;
    case Expr_kind:
        ret = qpast_v_expr(ctx, stmt->v.Expr.value, Load);
        break;
    case AsyncFunctionDef_kind:
        ret = qpast_v_body(ctx, stmt->v.AsyncFunctionDef.body, "AsyncFunctionDef") &&
              qpast_v_name(ctx, stmt->v.AsyncFunctionDef.name) &&
              qpast_v_type_params(ctx, stmt->v.AsyncFunctionDef.type_params) &&
              qpast_v_arguments(ctx, stmt->v.AsyncFunctionDef.args) &&
              qpast_v_exprs(ctx, stmt->v.AsyncFunctionDef.decorator_list, Load, 0) &&
              (!stmt->v.AsyncFunctionDef.returns ||
               qpast_v_expr(ctx, stmt->v.AsyncFunctionDef.returns, Load));
        break;
    case Pass_kind:
    case Break_kind:
    case Continue_kind:
        ret = 1;
        break;
    }
    if (ret < 0) {
        qp_raise_system_error(ctx, "unexpected statement");
        ret = 0;
    }
    return ret;
}

static int qpast_v_stmts(JSContext *ctx, asdl_stmt_seq *seq)
{
    Py_ssize_t i;
    for (i = 0; i < asdl_seq_LEN(seq); i++) {
        stmt_ty stmt = asdl_seq_GET(seq, i);
        if (stmt) {
            if (!qpast_v_stmt(ctx, stmt))
                return 0;
        } else {
            qp_raise_value_error(ctx, "None disallowed in statement list");
            return 0;
        }
    }
    return 1;
}

static int qpast_v_exprs(JSContext *ctx, asdl_expr_seq *exprs, expr_context_ty ectx, int null_ok)
{
    Py_ssize_t i;
    for (i = 0; i < asdl_seq_LEN(exprs); i++) {
        expr_ty expr = asdl_seq_GET(exprs, i);
        if (expr) {
            if (!qpast_v_expr(ctx, expr, ectx))
                return 0;
        } else if (!null_ok) {
            qp_raise_value_error(ctx, "None disallowed in expression list");
            return 0;
        }
    }
    return 1;
}

static int qpast_v_patterns(JSContext *ctx, asdl_pattern_seq *patterns, int star_ok)
{
    Py_ssize_t i;
    for (i = 0; i < asdl_seq_LEN(patterns); i++) {
        pattern_ty pattern = asdl_seq_GET(patterns, i);
        if (!qpast_v_pattern(ctx, pattern, star_ok))
            return 0;
    }
    return 1;
}

static int qpast_v_typeparam(JSContext *ctx, type_param_ty tp)
{
    int ret = -1;
    QPAST_VALIDATE_POSITIONS(tp);
    switch (tp->kind) {
    case TypeVar_kind:
        ret = qpast_v_name(ctx, tp->v.TypeVar.name) &&
              (!tp->v.TypeVar.bound || qpast_v_expr(ctx, tp->v.TypeVar.bound, Load)) &&
              (!tp->v.TypeVar.default_value ||
               qpast_v_expr(ctx, tp->v.TypeVar.default_value, Load));
        break;
    case ParamSpec_kind:
        ret = qpast_v_name(ctx, tp->v.ParamSpec.name) &&
              (!tp->v.ParamSpec.default_value ||
               qpast_v_expr(ctx, tp->v.ParamSpec.default_value, Load));
        break;
    case TypeVarTuple_kind:
        ret = qpast_v_name(ctx, tp->v.TypeVarTuple.name) &&
              (!tp->v.TypeVarTuple.default_value ||
               qpast_v_expr(ctx, tp->v.TypeVarTuple.default_value, Load));
        break;
    }
    return ret;
}

static int qpast_v_type_params(JSContext *ctx, asdl_type_param_seq *tps)
{
    Py_ssize_t i;
    for (i = 0; i < asdl_seq_LEN(tps); i++) {
        type_param_ty tp = asdl_seq_GET(tps, i);
        if (tp && !qpast_v_typeparam(ctx, tp))
            return 0;
    }
    return 1;
}

/* _PyAST_Validate: 1 valid, 0 with an exception pending. */
static int qp_ast_validate(JSContext *ctx, mod_ty mod)
{
    int res = -1;
    switch (mod->kind) {
    case Module_kind:
        res = qpast_v_stmts(ctx, mod->v.Module.body);
        break;
    case Interactive_kind:
        res = qpast_v_stmts(ctx, mod->v.Interactive.body);
        break;
    case Expression_kind:
        res = qpast_v_expr(ctx, mod->v.Expression.body, Load);
        break;
    case FunctionType_kind:
        res = qpast_v_exprs(ctx, mod->v.FunctionType.argtypes, Load, 0) &&
              qpast_v_expr(ctx, mod->v.FunctionType.returns, Load);
        break;
    }
    if (res < 0) {
        qp_raise_system_error(ctx, "impossible module node");
        return 0;
    }
    return res;
}

/* ---- _PyAST_Preprocess (Python/ast_preprocess.c) -------------------------- */

/* Control-flow-in-finally SyntaxWarnings are not part of this path:
   _PyCompile_AstPreprocess runs it with enable_warnings = 0. */
typedef struct QPAstPP {
    JSContext *ctx;
    qp_arena *arena;
    int optimize;
    int ff_features;
    int syntax_check_only;
} QPAstPP;

static int qpast_pp_mod(QPAstPP *st, mod_ty node_);
static int qpast_pp_stmt(QPAstPP *st, stmt_ty node_);
static int qpast_pp_expr(QPAstPP *st, expr_ty node_);
static int qpast_pp_arguments(QPAstPP *st, arguments_ty node_);
static int qpast_pp_comprehension(QPAstPP *st, comprehension_ty node_);
static int qpast_pp_keyword(QPAstPP *st, keyword_ty node_);
static int qpast_pp_arg(QPAstPP *st, arg_ty node_);
static int qpast_pp_withitem(QPAstPP *st, withitem_ty node_);
static int qpast_pp_excepthandler(QPAstPP *st, excepthandler_ty node_);
static int qpast_pp_match_case(QPAstPP *st, match_case_ty node_);
static int qpast_pp_pattern(QPAstPP *st, pattern_ty node_);
static int qpast_pp_type_param(QPAstPP *st, type_param_ty node_);

#define QPAST_PP_ENTER()                                                      \
    if (qpast_check_stack(st->ctx, " during compilation", NULL) < 0)          \
        return 0;

#define QPAST_CALL(FUNC, ARG)                                                 \
    if (!FUNC(st, (ARG)))                                                     \
        return 0;

#define QPAST_CALL_OPT(FUNC, ARG)                                             \
    if ((ARG) != NULL && !FUNC(st, (ARG)))                                    \
        return 0;

#define QPAST_CALL_SEQ(FUNC, TYPE, ARG) {                                     \
    Py_ssize_t i_;                                                            \
    asdl_ ## TYPE ## _seq *seq_ = (ARG);                                      \
    for (i_ = 0; i_ < asdl_seq_LEN(seq_); i_++) {                             \
        TYPE ## _ty elt_ = (TYPE ## _ty)asdl_seq_GET(seq_, i_);              \
        if (elt_ != NULL && !FUNC(st, elt_))                                  \
            return 0;                                                         \
    }                                                                         \
}

/* An arena allocation (constructor) failed. */
static int qpast_pp_arena_failure(QPAstPP *st)
{
    qpast_raise_arena_error(st->ctx, st->arena);
    return 0;
}

/* make_const: `val` is consumed; JS_EXCEPTION means the folding failed
   (the error is dropped unless it is a KeyboardInterrupt). */
static int qpast_pp_make_const(QPAstPP *st, expr_ty node, JSValue val)
{
    JSContext *ctx = st->ctx;
    qp_const *c;
    if (JS_IsException(val)) {
        if (qp_exc_pending_matches(ctx, QP_EXC(ctx, KeyboardInterrupt)))
            return 0;
        JS_FreeValue(ctx, qp_exc_fetch(ctx));
        return 1;
    }
    c = qpast_obj2const(ctx, st->arena, val);
    JS_FreeValue(ctx, val);
    if (!c)
        return 0;
    node->kind = Constant_kind;
    node->v.Constant.kind = JS_ATOM_NULL;
    node->v.Constant.value = c;
    return 1;
}

static int qpast_pp_has_starred(asdl_expr_seq *elts)
{
    Py_ssize_t i, n = asdl_seq_LEN(elts);
    for (i = 0; i < n; i++) {
        expr_ty e = (expr_ty)asdl_seq_GET(elts, i);
        if (e->kind == Starred_kind)
            return 1;
    }
    return 0;
}

/* str constant expression (no location) from code points */
static expr_ty qpast_pp_str_constant(QPAstPP *st, const uint32_t *cps, size_t n)
{
    JSValue s = qp_str_from_ucs4(st->ctx, cps, n);
    qp_const *c;
    expr_ty e;
    if (JS_IsException(s))
        return NULL;
    c = qpast_obj2const(st->ctx, st->arena, s);
    JS_FreeValue(st->ctx, s);
    if (!c)
        return NULL;
    e = _PyAST_Constant(c, JS_ATOM_NULL, -1, -1, -1, -1, st->arena);
    if (!e)
        qpast_pp_arena_failure(st);
    return e;
}

/* parse_literal: the literal text up to the next lone '%' ('%%' -> '%').
   NULL without exception when empty; *perr set on error. */
static expr_ty qpast_pp_parse_literal(QPAstPP *st, const qp_strview *fmt, Py_ssize_t *ppos,
                                      int *perr)
{
    Py_ssize_t start, pos, size = fmt->len;
    uint32_t *cps;
    size_t n = 0;
    expr_ty e;

    start = pos = *ppos;
    while (pos < size) {
        if (QP_SL_READ(fmt->kind, fmt->data, pos) != '%')
            pos++;
        else if (pos + 1 < size && QP_SL_READ(fmt->kind, fmt->data, pos + 1) == '%')
            pos += 2;
        else
            break;
    }
    *ppos = pos;
    if (pos == start)
        return NULL;
    cps = js_malloc(st->ctx, sizeof(cps[0]) * (pos - start));
    if (!cps) {
        *perr = 1;
        return NULL;
    }
    while (start < pos) {
        uint32_t ch = QP_SL_READ(fmt->kind, fmt->data, start);
        cps[n++] = ch;
        start += (ch == '%') ? 2 : 1;   /* "%%" -> "%" */
    }
    e = qpast_pp_str_constant(st, cps, n);
    js_free(st->ctx, cps);
    if (!e)
        *perr = 1;
    return e;
}

#define QPAST_F_LJUST (1<<0)
#define QPAST_F_SIGN  (1<<1)
#define QPAST_F_BLANK (1<<2)
#define QPAST_F_ALT   (1<<3)
#define QPAST_F_ZERO  (1<<4)
#define QPAST_MAXDIGITS 3

static int qpast_pp_simple_format_arg_parse(const qp_strview *fmt, Py_ssize_t *ppos, int *spec,
                                            int *flags, int *width, int *prec)
{
    Py_ssize_t pos = *ppos, len = fmt->len;
    uint32_t ch;

#define QPAST_NEXTC do {                        \
    if (pos >= len)                             \
        return 0;                               \
    ch = QP_SL_READ(fmt->kind, fmt->data, pos); \
    pos++;                                      \
} while (0)

    *flags = 0;
    for (;;) {
        QPAST_NEXTC;
        switch (ch) {
        case '-': *flags |= QPAST_F_LJUST; continue;
        case '+': *flags |= QPAST_F_SIGN; continue;
        case ' ': *flags |= QPAST_F_BLANK; continue;
        case '#': *flags |= QPAST_F_ALT; continue;
        case '0': *flags |= QPAST_F_ZERO; continue;
        }
        break;
    }
    if ('0' <= ch && ch <= '9') {
        int digits = 0;
        *width = 0;
        while ('0' <= ch && ch <= '9') {
            *width = *width * 10 + (ch - '0');
            QPAST_NEXTC;
            if (++digits >= QPAST_MAXDIGITS)
                return 0;
        }
    }
    if (ch == '.') {
        QPAST_NEXTC;
        *prec = 0;
        if ('0' <= ch && ch <= '9') {
            int digits = 0;
            while ('0' <= ch && ch <= '9') {
                *prec = *prec * 10 + (ch - '0');
                QPAST_NEXTC;
                if (++digits >= QPAST_MAXDIGITS)
                    return 0;
            }
        }
    }
    *spec = ch;
    *ppos = pos;
    return 1;
#undef QPAST_NEXTC
}

/* parse_format: a %s / %r / %a unit as a FormattedValue; NULL without
   error for unsupported formats. */
static expr_ty qpast_pp_parse_format(QPAstPP *st, const qp_strview *fmt, Py_ssize_t *ppos,
                                     expr_ty arg, int *perr)
{
    int spec, flags, width = -1, prec = -1;
    if (!qpast_pp_simple_format_arg_parse(fmt, ppos, &spec, &flags, &width, &prec))
        return NULL;   /* Unsupported format. */
    if (spec == 's' || spec == 'r' || spec == 'a') {
        char buf[1 + QPAST_MAXDIGITS + 1 + QPAST_MAXDIGITS + 1], *p = buf;
        expr_ty format_spec = NULL, res;
        if (!(flags & QPAST_F_LJUST) && width > 0)
            *p++ = '>';
        if (width >= 0)
            p += snprintf(p, QPAST_MAXDIGITS + 1, "%d", width);
        if (prec >= 0)
            p += snprintf(p, QPAST_MAXDIGITS + 2, ".%d", prec);
        if (p != buf) {
            uint32_t cps[sizeof(buf)];
            size_t i, n = p - buf;
            for (i = 0; i < n; i++)
                cps[i] = (unsigned char)buf[i];
            format_spec = qpast_pp_str_constant(st, cps, n);
            if (!format_spec) {
                *perr = 1;
                return NULL;
            }
        }
        res = _PyAST_FormattedValue(arg, spec, format_spec, arg->lineno, arg->col_offset,
                                    arg->end_lineno, arg->end_col_offset, st->arena);
        if (!res) {
            qpast_pp_arena_failure(st);
            *perr = 1;
        }
        return res;
    }
    return NULL;   /* Unsupported format. */
}

static int qpast_pp_optimize_format(QPAstPP *st, expr_ty node, const qp_strview *fmt,
                                    asdl_expr_seq *elts)
{
    Py_ssize_t pos = 0, cnt = 0;
    asdl_expr_seq *seq = _Py_asdl_expr_seq_new(asdl_seq_LEN(elts) * 2 + 1, st->arena);
    expr_ty res;
    int err = 0;

    if (!seq)
        return qpast_pp_arena_failure(st);
    seq->size = 0;
    for (;;) {
        expr_ty lit = qpast_pp_parse_literal(st, fmt, &pos, &err);
        if (lit)
            asdl_seq_SET(seq, seq->size++, lit);
        else if (err)
            return 0;
        if (pos >= fmt->len)
            break;
        if (cnt >= asdl_seq_LEN(elts))
            return 1;   /* More format units than items. */
        pos++;          /* the '%' */
        {
            expr_ty expr = qpast_pp_parse_format(st, fmt, &pos, asdl_seq_GET(elts, cnt), &err);
            cnt++;
            if (!expr)
                return !err;
            asdl_seq_SET(seq, seq->size++, expr);
        }
    }
    if (cnt < asdl_seq_LEN(elts))
        return 1;       /* More items than format units. */
    res = _PyAST_JoinedStr(seq, node->lineno, node->col_offset, node->end_lineno,
                           node->end_col_offset, st->arena);
    if (!res)
        return qpast_pp_arena_failure(st);
    memcpy(node, res, sizeof(struct _expr));   /* COPY_NODE */
    return 1;
}

static int qpast_pp_fold_binop(QPAstPP *st, expr_ty node)
{
    expr_ty lhs, rhs;
    if (st->syntax_check_only)
        return 1;
    lhs = node->v.BinOp.left;
    rhs = node->v.BinOp.right;
    if (lhs->kind != Constant_kind)
        return 1;
    if (node->v.BinOp.op == Mod && rhs->kind == Tuple_kind &&
        lhs->v.Constant.value->kind == QP_CONST_STR &&
        !qpast_pp_has_starred(rhs->v.Tuple.elts)) {
        qp_strview view;
        int r;
        if (qp_str_view_acquire(st->ctx, lhs->v.Constant.value->v, &view) < 0)
            return 0;
        r = qpast_pp_optimize_format(st, node, &view, rhs->v.Tuple.elts);
        qp_str_view_release(st->ctx, &view);
        return r;
    }
    return 1;
}

/* _PyAST_GetDocString */
static BOOL qpast_pp_has_docstring(asdl_stmt_seq *body)
{
    stmt_ty s;
    expr_ty e;
    if (!asdl_seq_LEN(body))
        return FALSE;
    s = asdl_seq_GET(body, 0);
    if (s->kind != Expr_kind)
        return FALSE;
    e = s->v.Expr.value;
    return e->kind == Constant_kind && e->v.Constant.value->kind == QP_CONST_STR;
}

static int qpast_pp_remove_docstring(QPAstPP *st, asdl_stmt_seq *stmts)
{
    Py_ssize_t i;
    /* Just the docstring in the body: replace it with `pass`, so the body
       is not empty. */
    if (asdl_seq_LEN(stmts) == 1) {
        stmt_ty docstring = (stmt_ty)asdl_seq_GET(stmts, 0);
        stmt_ty pass = _PyAST_Pass(docstring->lineno, docstring->col_offset,
                                   /* `pass` always takes 4 chars on a single line */
                                   docstring->lineno, docstring->col_offset + 4,
                                   st->arena);
        if (!pass)
            return qpast_pp_arena_failure(st);
        asdl_seq_SET(stmts, 0, pass);
        return 1;
    }
    for (i = 0; i < asdl_seq_LEN(stmts) - 1; i++)
        asdl_seq_SET(stmts, i, asdl_seq_GET(stmts, i + 1));
    stmts->size--;
    return 1;
}

static int qpast_pp_body(QPAstPP *st, asdl_stmt_seq *stmts)
{
    int docstring = qpast_pp_has_docstring(stmts);
    if (docstring && st->optimize >= 2) {
        /* remove the docstring */
        if (!qpast_pp_remove_docstring(st, stmts))
            return 0;
        docstring = 0;
    }
    QPAST_CALL_SEQ(qpast_pp_stmt, stmt, stmts);
    if (!docstring && qpast_pp_has_docstring(stmts)) {
        stmt_ty s = (stmt_ty)asdl_seq_GET(stmts, 0);
        asdl_expr_seq *values = _Py_asdl_expr_seq_new(1, st->arena);
        expr_ty expr;
        if (!values)
            return qpast_pp_arena_failure(st);
        asdl_seq_SET(values, 0, s->v.Expr.value);
        expr = _PyAST_JoinedStr(values, s->lineno, s->col_offset, s->end_lineno,
                                s->end_col_offset, st->arena);
        if (!expr)
            return qpast_pp_arena_failure(st);
        s->v.Expr.value = expr;
    }
    return 1;
}

static int qpast_pp_mod(QPAstPP *st, mod_ty node_)
{
    switch (node_->kind) {
    case Module_kind:
        QPAST_CALL(qpast_pp_body, node_->v.Module.body);
        break;
    case Interactive_kind:
        QPAST_CALL_SEQ(qpast_pp_stmt, stmt, node_->v.Interactive.body);
        break;
    case Expression_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.Expression.body);
        break;
    /* The following top level nodes don't participate in constant folding */
    case FunctionType_kind:
        break;
    }
    return 1;
}

static int qpast_pp_expr(QPAstPP *st, expr_ty node_)
{
    QPAST_PP_ENTER();
    switch (node_->kind) {
    case BoolOp_kind:
        QPAST_CALL_SEQ(qpast_pp_expr, expr, node_->v.BoolOp.values);
        break;
    case BinOp_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.BinOp.left);
        QPAST_CALL(qpast_pp_expr, node_->v.BinOp.right);
        QPAST_CALL(qpast_pp_fold_binop, node_);
        break;
    case UnaryOp_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.UnaryOp.operand);
        break;
    case Lambda_kind:
        QPAST_CALL(qpast_pp_arguments, node_->v.Lambda.args);
        QPAST_CALL(qpast_pp_expr, node_->v.Lambda.body);
        break;
    case IfExp_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.IfExp.test);
        QPAST_CALL(qpast_pp_expr, node_->v.IfExp.body);
        QPAST_CALL(qpast_pp_expr, node_->v.IfExp.orelse);
        break;
    case Dict_kind:
        QPAST_CALL_SEQ(qpast_pp_expr, expr, node_->v.Dict.keys);
        QPAST_CALL_SEQ(qpast_pp_expr, expr, node_->v.Dict.values);
        break;
    case Set_kind:
        QPAST_CALL_SEQ(qpast_pp_expr, expr, node_->v.Set.elts);
        break;
    case ListComp_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.ListComp.elt);
        QPAST_CALL_SEQ(qpast_pp_comprehension, comprehension, node_->v.ListComp.generators);
        break;
    case SetComp_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.SetComp.elt);
        QPAST_CALL_SEQ(qpast_pp_comprehension, comprehension, node_->v.SetComp.generators);
        break;
    case DictComp_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.DictComp.key);
        if (node_->v.DictComp.value != NULL)
            QPAST_CALL(qpast_pp_expr, node_->v.DictComp.value);
        QPAST_CALL_SEQ(qpast_pp_comprehension, comprehension, node_->v.DictComp.generators);
        break;
    case GeneratorExp_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.GeneratorExp.elt);
        QPAST_CALL_SEQ(qpast_pp_comprehension, comprehension, node_->v.GeneratorExp.generators);
        break;
    case Await_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.Await.value);
        break;
    case Yield_kind:
        QPAST_CALL_OPT(qpast_pp_expr, node_->v.Yield.value);
        break;
    case YieldFrom_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.YieldFrom.value);
        break;
    case Compare_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.Compare.left);
        QPAST_CALL_SEQ(qpast_pp_expr, expr, node_->v.Compare.comparators);
        break;
    case Call_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.Call.func);
        QPAST_CALL_SEQ(qpast_pp_expr, expr, node_->v.Call.args);
        QPAST_CALL_SEQ(qpast_pp_keyword, keyword, node_->v.Call.keywords);
        break;
    case FormattedValue_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.FormattedValue.value);
        QPAST_CALL_OPT(qpast_pp_expr, node_->v.FormattedValue.format_spec);
        break;
    case Interpolation_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.Interpolation.value);
        QPAST_CALL_OPT(qpast_pp_expr, node_->v.Interpolation.format_spec);
        break;
    case JoinedStr_kind:
        QPAST_CALL_SEQ(qpast_pp_expr, expr, node_->v.JoinedStr.values);
        break;
    case TemplateStr_kind:
        QPAST_CALL_SEQ(qpast_pp_expr, expr, node_->v.TemplateStr.values);
        break;
    case Attribute_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.Attribute.value);
        break;
    case Subscript_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.Subscript.value);
        QPAST_CALL(qpast_pp_expr, node_->v.Subscript.slice);
        break;
    case Starred_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.Starred.value);
        break;
    case Slice_kind:
        QPAST_CALL_OPT(qpast_pp_expr, node_->v.Slice.lower);
        QPAST_CALL_OPT(qpast_pp_expr, node_->v.Slice.upper);
        QPAST_CALL_OPT(qpast_pp_expr, node_->v.Slice.step);
        break;
    case List_kind:
        QPAST_CALL_SEQ(qpast_pp_expr, expr, node_->v.List.elts);
        break;
    case Tuple_kind:
        QPAST_CALL_SEQ(qpast_pp_expr, expr, node_->v.Tuple.elts);
        break;
    case Name_kind:
        if (st->syntax_check_only)
            break;
        if (node_->v.Name.ctx == Load && qpast_atom_eq(st->ctx, node_->v.Name.id, "__debug__"))
            return qpast_pp_make_const(st, node_, JS_NewBool(st->ctx, !st->optimize));
        break;
    case NamedExpr_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.NamedExpr.value);
        break;
    case Constant_kind:
        /* Already a constant, nothing further to do */
        break;
    }
    return 1;
}

static int qpast_pp_keyword(QPAstPP *st, keyword_ty node_)
{
    QPAST_CALL(qpast_pp_expr, node_->value);
    return 1;
}

static int qpast_pp_comprehension(QPAstPP *st, comprehension_ty node_)
{
    QPAST_CALL(qpast_pp_expr, node_->target);
    QPAST_CALL(qpast_pp_expr, node_->iter);
    QPAST_CALL_SEQ(qpast_pp_expr, expr, node_->ifs);
    return 1;
}

static int qpast_pp_arguments(QPAstPP *st, arguments_ty node_)
{
    QPAST_CALL_SEQ(qpast_pp_arg, arg, node_->posonlyargs);
    QPAST_CALL_SEQ(qpast_pp_arg, arg, node_->args);
    QPAST_CALL_OPT(qpast_pp_arg, node_->vararg);
    QPAST_CALL_SEQ(qpast_pp_arg, arg, node_->kwonlyargs);
    QPAST_CALL_SEQ(qpast_pp_expr, expr, node_->kw_defaults);
    QPAST_CALL_OPT(qpast_pp_arg, node_->kwarg);
    QPAST_CALL_SEQ(qpast_pp_expr, expr, node_->defaults);
    return 1;
}

static int qpast_pp_arg(QPAstPP *st, arg_ty node_)
{
    if (!(st->ff_features & CO_FUTURE_ANNOTATIONS))
        QPAST_CALL_OPT(qpast_pp_expr, node_->annotation);
    return 1;
}

static int qpast_pp_stmt(QPAstPP *st, stmt_ty node_)
{
    QPAST_PP_ENTER();
    switch (node_->kind) {
    case FunctionDef_kind:
        QPAST_CALL_SEQ(qpast_pp_type_param, type_param, node_->v.FunctionDef.type_params);
        QPAST_CALL(qpast_pp_arguments, node_->v.FunctionDef.args);
        QPAST_CALL(qpast_pp_body, node_->v.FunctionDef.body);
        QPAST_CALL_SEQ(qpast_pp_expr, expr, node_->v.FunctionDef.decorator_list);
        if (!(st->ff_features & CO_FUTURE_ANNOTATIONS))
            QPAST_CALL_OPT(qpast_pp_expr, node_->v.FunctionDef.returns);
        break;
    case AsyncFunctionDef_kind:
        QPAST_CALL_SEQ(qpast_pp_type_param, type_param, node_->v.AsyncFunctionDef.type_params);
        QPAST_CALL(qpast_pp_arguments, node_->v.AsyncFunctionDef.args);
        QPAST_CALL(qpast_pp_body, node_->v.AsyncFunctionDef.body);
        QPAST_CALL_SEQ(qpast_pp_expr, expr, node_->v.AsyncFunctionDef.decorator_list);
        if (!(st->ff_features & CO_FUTURE_ANNOTATIONS))
            QPAST_CALL_OPT(qpast_pp_expr, node_->v.AsyncFunctionDef.returns);
        break;
    case ClassDef_kind:
        QPAST_CALL_SEQ(qpast_pp_type_param, type_param, node_->v.ClassDef.type_params);
        QPAST_CALL_SEQ(qpast_pp_expr, expr, node_->v.ClassDef.bases);
        QPAST_CALL_SEQ(qpast_pp_keyword, keyword, node_->v.ClassDef.keywords);
        QPAST_CALL(qpast_pp_body, node_->v.ClassDef.body);
        QPAST_CALL_SEQ(qpast_pp_expr, expr, node_->v.ClassDef.decorator_list);
        break;
    case Return_kind:
        QPAST_CALL_OPT(qpast_pp_expr, node_->v.Return.value);
        break;
    case Delete_kind:
        QPAST_CALL_SEQ(qpast_pp_expr, expr, node_->v.Delete.targets);
        break;
    case Assign_kind:
        QPAST_CALL_SEQ(qpast_pp_expr, expr, node_->v.Assign.targets);
        QPAST_CALL(qpast_pp_expr, node_->v.Assign.value);
        break;
    case AugAssign_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.AugAssign.target);
        QPAST_CALL(qpast_pp_expr, node_->v.AugAssign.value);
        break;
    case AnnAssign_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.AnnAssign.target);
        if (!(st->ff_features & CO_FUTURE_ANNOTATIONS))
            QPAST_CALL(qpast_pp_expr, node_->v.AnnAssign.annotation);
        QPAST_CALL_OPT(qpast_pp_expr, node_->v.AnnAssign.value);
        break;
    case TypeAlias_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.TypeAlias.name);
        QPAST_CALL_SEQ(qpast_pp_type_param, type_param, node_->v.TypeAlias.type_params);
        QPAST_CALL(qpast_pp_expr, node_->v.TypeAlias.value);
        break;
    case For_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.For.target);
        QPAST_CALL(qpast_pp_expr, node_->v.For.iter);
        QPAST_CALL_SEQ(qpast_pp_stmt, stmt, node_->v.For.body);
        QPAST_CALL_SEQ(qpast_pp_stmt, stmt, node_->v.For.orelse);
        break;
    case AsyncFor_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.AsyncFor.target);
        QPAST_CALL(qpast_pp_expr, node_->v.AsyncFor.iter);
        QPAST_CALL_SEQ(qpast_pp_stmt, stmt, node_->v.AsyncFor.body);
        QPAST_CALL_SEQ(qpast_pp_stmt, stmt, node_->v.AsyncFor.orelse);
        break;
    case While_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.While.test);
        QPAST_CALL_SEQ(qpast_pp_stmt, stmt, node_->v.While.body);
        QPAST_CALL_SEQ(qpast_pp_stmt, stmt, node_->v.While.orelse);
        break;
    case If_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.If.test);
        QPAST_CALL_SEQ(qpast_pp_stmt, stmt, node_->v.If.body);
        QPAST_CALL_SEQ(qpast_pp_stmt, stmt, node_->v.If.orelse);
        break;
    case With_kind:
        QPAST_CALL_SEQ(qpast_pp_withitem, withitem, node_->v.With.items);
        QPAST_CALL_SEQ(qpast_pp_stmt, stmt, node_->v.With.body);
        break;
    case AsyncWith_kind:
        QPAST_CALL_SEQ(qpast_pp_withitem, withitem, node_->v.AsyncWith.items);
        QPAST_CALL_SEQ(qpast_pp_stmt, stmt, node_->v.AsyncWith.body);
        break;
    case Raise_kind:
        QPAST_CALL_OPT(qpast_pp_expr, node_->v.Raise.exc);
        QPAST_CALL_OPT(qpast_pp_expr, node_->v.Raise.cause);
        break;
    case Try_kind:
        QPAST_CALL_SEQ(qpast_pp_stmt, stmt, node_->v.Try.body);
        QPAST_CALL_SEQ(qpast_pp_excepthandler, excepthandler, node_->v.Try.handlers);
        QPAST_CALL_SEQ(qpast_pp_stmt, stmt, node_->v.Try.orelse);
        QPAST_CALL_SEQ(qpast_pp_stmt, stmt, node_->v.Try.finalbody);
        break;
    case TryStar_kind:
        QPAST_CALL_SEQ(qpast_pp_stmt, stmt, node_->v.TryStar.body);
        QPAST_CALL_SEQ(qpast_pp_excepthandler, excepthandler, node_->v.TryStar.handlers);
        QPAST_CALL_SEQ(qpast_pp_stmt, stmt, node_->v.TryStar.orelse);
        QPAST_CALL_SEQ(qpast_pp_stmt, stmt, node_->v.TryStar.finalbody);
        break;
    case Assert_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.Assert.test);
        QPAST_CALL_OPT(qpast_pp_expr, node_->v.Assert.msg);
        break;
    case Expr_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.Expr.value);
        break;
    case Match_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.Match.subject);
        QPAST_CALL_SEQ(qpast_pp_match_case, match_case, node_->v.Match.cases);
        break;
    /* The following statements don't contain any subexpressions to be folded */
    case Break_kind:
    case Continue_kind:
    case Import_kind:
    case ImportFrom_kind:
    case Global_kind:
    case Nonlocal_kind:
    case Pass_kind:
        break;
    }
    return 1;
}

static int qpast_pp_excepthandler(QPAstPP *st, excepthandler_ty node_)
{
    switch (node_->kind) {
    case ExceptHandler_kind:
        QPAST_CALL_OPT(qpast_pp_expr, node_->v.ExceptHandler.type);
        QPAST_CALL_SEQ(qpast_pp_stmt, stmt, node_->v.ExceptHandler.body);
        break;
    }
    return 1;
}

static int qpast_pp_withitem(QPAstPP *st, withitem_ty node_)
{
    QPAST_CALL(qpast_pp_expr, node_->context_expr);
    QPAST_CALL_OPT(qpast_pp_expr, node_->optional_vars);
    return 1;
}

static int qpast_pp_fold_const_match_patterns(QPAstPP *st, expr_ty node)
{
    JSContext *ctx = st->ctx;
    if (st->syntax_check_only)
        return 1;
    switch (node->kind) {
    case UnaryOp_kind:
        if ((node->v.UnaryOp.op == USub || node->v.UnaryOp.op == UAdd) &&
            node->v.UnaryOp.operand->kind == Constant_kind) {
            JSValue operand = qpast_const2obj(ctx, node->v.UnaryOp.operand->v.Constant.value);
            JSValue folded;
            if (JS_IsException(operand))
                return qpast_pp_make_const(st, node, JS_EXCEPTION);
            folded = qp_unop(ctx, operand,
                             node->v.UnaryOp.op == USub ? QP_UNOP_NEG : QP_UNOP_POS);
            JS_FreeValue(ctx, operand);
            return qpast_pp_make_const(st, node, folded);
        }
        break;
    case BinOp_kind: {
        operator_ty op = node->v.BinOp.op;
        if ((op == Add || op == Sub) && node->v.BinOp.right->kind == Constant_kind) {
            QPAST_CALL(qpast_pp_fold_const_match_patterns, node->v.BinOp.left);
            if (node->v.BinOp.left->kind == Constant_kind) {
                JSValue left = qpast_const2obj(ctx, node->v.BinOp.left->v.Constant.value);
                JSValue right, folded;
                if (JS_IsException(left))
                    return qpast_pp_make_const(st, node, JS_EXCEPTION);
                right = qpast_const2obj(ctx, node->v.BinOp.right->v.Constant.value);
                if (JS_IsException(right)) {
                    JS_FreeValue(ctx, left);
                    return qpast_pp_make_const(st, node, JS_EXCEPTION);
                }
                folded = qp_binop(ctx, left, right, op == Add ? QP_NB_ADD : QP_NB_SUBTRACT);
                JS_FreeValue(ctx, left);
                JS_FreeValue(ctx, right);
                return qpast_pp_make_const(st, node, folded);
            }
        }
        break;
    }
    default:
        break;
    }
    return 1;
}

static int qpast_pp_pattern(QPAstPP *st, pattern_ty node_)
{
    /* Only used to form complex/negative numeric constants in MatchValue and
       MatchMapping nodes; still recurse into all subexpressions and
       subpatterns. */
    QPAST_PP_ENTER();
    switch (node_->kind) {
    case MatchValue_kind:
        QPAST_CALL(qpast_pp_fold_const_match_patterns, node_->v.MatchValue.value);
        break;
    case MatchSingleton_kind:
        break;
    case MatchSequence_kind:
        QPAST_CALL_SEQ(qpast_pp_pattern, pattern, node_->v.MatchSequence.patterns);
        break;
    case MatchMapping_kind:
        QPAST_CALL_SEQ(qpast_pp_fold_const_match_patterns, expr, node_->v.MatchMapping.keys);
        QPAST_CALL_SEQ(qpast_pp_pattern, pattern, node_->v.MatchMapping.patterns);
        break;
    case MatchClass_kind:
        QPAST_CALL(qpast_pp_expr, node_->v.MatchClass.cls);
        QPAST_CALL_SEQ(qpast_pp_pattern, pattern, node_->v.MatchClass.patterns);
        QPAST_CALL_SEQ(qpast_pp_pattern, pattern, node_->v.MatchClass.kwd_patterns);
        break;
    case MatchStar_kind:
        break;
    case MatchAs_kind:
        if (node_->v.MatchAs.pattern)
            QPAST_CALL(qpast_pp_pattern, node_->v.MatchAs.pattern);
        break;
    case MatchOr_kind:
        QPAST_CALL_SEQ(qpast_pp_pattern, pattern, node_->v.MatchOr.patterns);
        break;
    }
    return 1;
}

static int qpast_pp_match_case(QPAstPP *st, match_case_ty node_)
{
    QPAST_CALL(qpast_pp_pattern, node_->pattern);
    QPAST_CALL_OPT(qpast_pp_expr, node_->guard);
    QPAST_CALL_SEQ(qpast_pp_stmt, stmt, node_->body);
    return 1;
}

static int qpast_pp_type_param(QPAstPP *st, type_param_ty node_)
{
    switch (node_->kind) {
    case TypeVar_kind:
        QPAST_CALL_OPT(qpast_pp_expr, node_->v.TypeVar.bound);
        QPAST_CALL_OPT(qpast_pp_expr, node_->v.TypeVar.default_value);
        break;
    case ParamSpec_kind:
        QPAST_CALL_OPT(qpast_pp_expr, node_->v.ParamSpec.default_value);
        break;
    case TypeVarTuple_kind:
        QPAST_CALL_OPT(qpast_pp_expr, node_->v.TypeVarTuple.default_value);
        break;
    }
    return 1;
}

#undef QPAST_CALL
#undef QPAST_CALL_OPT
#undef QPAST_CALL_SEQ

/* _PyCompile_AstPreprocess: __future__ features of the module merged with
   the compile flags, then _PyAST_Preprocess (no_const_folding =
   syntax_check_only, warnings off).  optimize -1 = the interpreter's -O
   level.  0, or -1 with an exception pending. */
static int qp_ast_preprocess(JSContext *ctx, mod_ty mod, const char *filename, int flags,
                             int optimize, qp_arena *arena, int syntax_check_only)
{
    _PyFutureFeatures future;
    qp_error err;
    QPAstPP st;

    memset(&err, 0, sizeof(err));
    if (!_PyFuture_FromAST(mod, filename, &future, arena, &err)) {
        if (err.kind != QP_ERR_NONE)
            qp_raise_qp_error(ctx, &err, filename);
        else
            qp_raise_memory_error(ctx);
        qp_error_clear(&err);
        return -1;
    }
    qp_error_clear(&err);
    st.ctx = ctx;
    st.arena = arena;
    st.optimize = optimize == -1 ? QP_STATE(ctx)->config.optimize : optimize;
    st.ff_features = future.ff_features | flags;
    st.syntax_check_only = syntax_check_only;
    return qpast_pp_mod(&st, mod) ? 0 : -1;
}

/* ---- entry points --------------------------------------------------------- */

/* PyAST_Check: isinstance(obj, ast.AST) */
static int qp_ast_check(JSContext *ctx, JSValueConst obj)
{
    const JSValue *st = qpast_state(ctx);
    if (!st)
        return -1;
    return qp_isinstance(ctx, obj, st[QPAST_T_AST]);
}

/* PyAST_mod2obj */
static JSValue qp_ast2obj(JSContext *ctx, mod_ty mod)
{
    QPAstConv cv;
    JSValue r;
    if (qpast_conv_init(&cv, ctx, NULL) < 0)
        return JS_EXCEPTION;
    r = qpast_node2obj(&cv, QPAST_T_mod, mod);
    qpast_conv_free(&cv);
    return r;
}

/* PyAST_obj2mod: mode 0 "exec", 1 "eval", 2 "single", 3 "func_type".
   NULL with an exception pending on failure. */
static mod_ty qp_obj2ast(JSContext *ctx, JSValueConst obj, qp_arena *arena, int mode)
{
    static const char *const req_name[] = { "Module", "Expression", "Interactive",
                                            "FunctionType" };
    static const int req_type[] = { QPAST_T_Module, QPAST_T_Expression, QPAST_T_Interactive,
                                    QPAST_T_FunctionType };
    QPAstConv cv;
    mod_ty res = NULL;
    int r;

    if (qpast_conv_init(&cv, ctx, arena) < 0)
        return NULL;
    /* PyAst_CheckMode */
    r = qp_isinstance(ctx, obj, cv.st[req_type[mode]]);
    if (r == 0) {
        char buf[64];
        qp_raise_type_error(ctx, "expected %s node, got %.400s", req_name[mode],
                            qpast_short_name(ctx, qp_type_of(ctx, obj), buf, sizeof(buf)));
    } else if (r > 0) {
        void *node;
        if (qpast_obj2node(&cv, QPAST_T_mod, obj, &node) == 0)
            res = node;
    }
    qpast_conv_free(&cv);
    return res;
}

/* ---- the _ast module ------------------------------------------------------ */

/* _is_abstract(cls): helper for the tests */
static JSValue qpast_is_abstract(JSContext *ctx, JSValueConst self, JSValueConst *args,
                                 int nargs, JSValueConst kwnames, int magic)
{
    const JSValue *st = qpast_state(ctx);
    int contains;
    if (!st)
        return JS_EXCEPTION;
    contains = qp_set_contains(ctx, QPAST_ST_ABSTRACT(st), args[0]);
    if (contains < 0)
        return JS_EXCEPTION;
    return JS_NewBool(ctx, contains);
}

static const QPMethodDef qpast_module_methods[] = {
    { "_is_abstract", qpast_is_abstract, QP_METH_O, 0, NULL },
    { NULL }
};

static int qpast_module_add(JSContext *ctx, JSValueConst module, const char *name, JSValue v)
{
    return qpast_dict_set_str(ctx, qp_module_get_dict(module), name, v);
}

static int qpast_module_exec(JSContext *ctx, JSValueConst module)
{
    const JSValue *st = qpast_state(ctx);
    int t;
    if (!st)
        return -1;
    if (qpast_module_add(ctx, module, "AST", JS_DupValue(ctx, st[QPAST_T_AST])) < 0 ||
        qpast_module_add(ctx, module, "PyCF_ALLOW_TOP_LEVEL_AWAIT",
                         JS_NewInt32(ctx, QPAST_PyCF_ALLOW_TOP_LEVEL_AWAIT)) < 0 ||
        qpast_module_add(ctx, module, "PyCF_ONLY_AST", JS_NewInt32(ctx, QPAST_PyCF_ONLY_AST)) < 0 ||
        qpast_module_add(ctx, module, "PyCF_TYPE_COMMENTS",
                         JS_NewInt32(ctx, QPAST_PyCF_TYPE_COMMENTS)) < 0 ||
        qpast_module_add(ctx, module, "PyCF_OPTIMIZED_AST",
                         JS_NewInt32(ctx, QPAST_PyCF_OPTIMIZED_AST)) < 0)
        return -1;
    for (t = 1; t < QPAST_T__COUNT; t++) {
        if (qpast_module_add(ctx, module, qpast_types[t].name, JS_DupValue(ctx, st[t])) < 0)
            return -1;
    }
    return 0;
}

static const QPModuleDef qp_moddef__ast = {
    "_ast",
    NULL,
    qpast_module_methods,
    qpast_module_exec,
};
